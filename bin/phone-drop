class _ZipStream:
    """A write-only file for zipfile that sends straight to the phone (no temp file)."""

    def __init__(self, out, count):
        self.out, self.count, self.pos = out, count, 0

    def write(self, b):
        self.out.write(b)
        self.pos += len(b)
        self.count(len(b))
        return len(b)

    def tell(self):
        return self.pos

    def flush(self):
        self.out.flush()


def make_handler(share, colours):
    class Handler(BaseHTTPRequestHandler):
        server_version = "PhoneDrop"
        protocol_version = "HTTP/1.1"

        def log_message(self, *_a):
            pass

        def _route(self):
            """('page'|'state'|'file'|'zip'|'up', arg) for a valid token, else None."""
            parts = urllib.parse.urlsplit(self.path)
            seg = parts.path.split("/")
            # /t/<token>/<rest>
            if len(seg) < 3 or seg[1] != "t" or not secrets.compare_digest(seg[2], share.token):
                return None, None, parts
            rest = seg[3:]
            share.last_use = time.time()
            share.hello(self.client_address[0])
            if rest in ([], [""]):
                return "page", None, parts
            if rest == ["state.json"]:
                return "state", None, parts
            if rest == ["all.zip"]:
                return "zip", None, parts
            if rest == ["up"]:
                return "up", None, parts
            if len(rest) == 2 and rest[0] == "f":
                return "file", rest[1], parts
            return None, None, parts

        def _send(self, code, body=b"", ctype="text/plain; charset=utf-8", extra=None):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _not_found(self):
            self._send(404, b"Not found")

        def do_GET(self):
            kind, arg, _parts = self._route()
            if kind == "page":
                body = PAGE % dict(colours, host=html.escape(laptop_name()))
                return self._send(200, body.encode(), "text/html; charset=utf-8")
            if kind == "state":
                have = urllib.parse.parse_qs(_parts.query).get("v", [""])[0]
                if have == str(share.version):
                    return self._send(204)  # nothing new: no body
                return self._send(200, json.dumps(share.state()).encode(), "application/json")
            if kind == "file":
                with share.lock:
                    item = share.items.get(arg)
                if not item:
                    return self._not_found()
                inline = "view=1" in _parts.query
                return self._zip([item], item["name"]) if item["dir"] else self._file(arg, item, inline)
            if kind == "zip":
                with share.lock:
                    items = list(share.items.values())
                return self._zip(items, "Phone Drop.zip") if items else self._not_found()
            return self._not_found()

        do_HEAD = do_GET

        def _disposition(self, name):
            ascii_name = name.encode("ascii", "replace").decode().replace('"', "")
            return f'attachment; filename="{ascii_name}"; filename*=UTF-8\'\'{urllib.parse.quote(name)}'

        def _file(self, item_id, item, inline=False):
            try:
                f = open(item["path"], "rb")
            except OSError:
                return self._not_found()
            with f:
                size = os.fstat(f.fileno()).st_size
                self.send_response(200)
                ctype = (mimetypes.guess_type(item["name"])[0] or "application/octet-stream") if inline \
                    else "application/octet-stream"
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(size))
                if not inline:
                    self.send_header("Content-Disposition", self._disposition(item["name"]))
                self.end_headers()
                if self.command == "HEAD":
                    return
                sent = 0
                while chunk := f.read(CHUNK):
                    self.wfile.write(chunk)
                    sent += len(chunk)
                    share.last_use = time.time()
                    if not inline:
                        share.on_event("progress", (item_id, sent, size))
                if not inline:
                    share.on_event("done", item_id)

        def _zip(self, items, name):
            self.send_response(200)
            self.send_header("Content-Type", "application/zip")
            self.send_header("Content-Disposition", self._disposition(name))
            self.send_header("Connection", "close")  # length unknown: the end of the stream ends it
            self.end_headers()
            self.close_connection = True
            if self.command == "HEAD":
                return
            total = sum(i["size"] for i in items) or 1
            done = [0]

            def count(n):
                done[0] += n
                share.last_use = time.time()
                for it_id, it in list(share.items.items()):
                    if it in items:
                        share.on_event("progress", (it_id, min(done[0], total), total))

            with zipfile.ZipFile(_ZipStream(self.wfile, count), "w", zipfile.ZIP_STORED, allowZip64=True) as z:
                for it in items:
                    if it["dir"]:
                        base = os.path.dirname(it["path"].rstrip("/"))
                        for root, _dirs, files in os.walk(it["path"]):
                            for fn in files:
                                p = os.path.join(root, fn)
                                if os.path.isfile(p):
                                    z.write(p, os.path.relpath(p, base))
                    elif os.path.isfile(it["path"]):
                        z.write(it["path"], it["name"])
            for it_id, it in list(share.items.items()):
                if it in items:
                    share.on_event("done", it_id)

        def do_PUT(self):
            kind, _arg, parts = self._route()
            if kind != "up":
                return self._not_found()
            try:
                length = int(self.headers.get("Content-Length", "-1"))
            except ValueError:
                length = -1
            if length < 0:
                return self._send(411, b"Length required")
            os.makedirs(INBOX, exist_ok=True)
            if shutil.disk_usage(INBOX).free < length + 200 * 1024 * 1024:
                return self._send(507, b"Not enough space on the laptop")
            name = clean_name(urllib.parse.parse_qs(parts.query).get("name", ["file"])[0])
            tmp = os.path.join(INBOX, f".incoming-{secrets.token_hex(6)}")
            left = length
            try:
                with open(tmp, "wb") as f:
                    while left > 0:
                        chunk = self.rfile.read(min(CHUNK, left))
                        if not chunk:
                            break
                        f.write(chunk)
                        left -= len(chunk)
                        share.last_use = time.time()
                if left:
                    raise OSError("upload cut short")
                final = unique_path(INBOX, name)
                os.replace(tmp, final)
            except OSError:
                try:
                    os.remove(tmp)
                except OSError:
                    pass
                return self._send(500, b"Upload failed")
            share.on_event("received", final)
            self._send(200, b"ok")

    return Handler


class Server:
    """Listens on every network at once (hotspot, Wi-Fi, Ethernet), all with the same secret,
    so switching which code is shown never restarts anything: phones already on the page
    keep working, and a cable plugged in or a hotspot turned on just adds one more address."""

    def __init__(self, share, colours):
        self.share, self.colours = share, colours
        self.httpds = {}      # ip -> running server
        self.ip = None        # the address shown in the QR code
        self.running = False

    def sync(self, ips):
        """Serve on exactly these addresses (start new ones, stop vanished ones)."""
        self.running = True
        for ip in [i for i in self.httpds if i not in ips]:
            self._close(ip)
        for ip in ips:
            if ip in self.httpds:
                continue
            try:
                httpd = ThreadingHTTPServer((ip, PORT), make_handler(self.share, self.colours))
            except OSError:
                continue  # address not usable (yet): the next network change retries
            httpd.daemon_threads = True
            self.httpds[ip] = httpd
            threading.Thread(target=httpd.serve_forever, kwargs={"poll_interval": 1.0}, daemon=True).start()

    def _close(self, ip):
        httpd = self.httpds.pop(ip, None)
        if httpd:
            httpd.shutdown()
            httpd.server_close()

    def start(self, ip):  # one address (tests and simple use)
        self.ip = ip
        self.sync([ip])

    def stop(self):
        for ip in list(self.httpds):
            self._close(ip)
        self.running = False

    @property
    def httpd(self):
        return self.httpds.get(self.ip)

    @property
    def url(self):
        return f"http://{self.ip}:{PORT}/t/{self.share.token}/"


def addresses():
    """[(label, ip)] best first: hotspot, Wi-Fi, Ethernet. VPN/docker/virtual ones are left out."""
    try:
        data = json.loads(subprocess.run(["ip", "-j", "-4", "addr"], capture_output=True, text=True,
                                         timeout=3).stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    out = []
    for link in data:
        ifn = link.get("ifname", "")
        if ifn == "lo" or ifn.startswith(("docker", "br-", "veth", "virbr", "tun", "tap", "wg", "proton", "ipv6")):
            continue
        for a in link.get("addr_info", []):
            ip = a.get("local", "")
            if not ip or ip.startswith("169.254."):
                continue
            if ifn.startswith("wl") and ip.startswith("10.42."):
                out.append((0, f"Hotspot ({ip})", ip))
            elif ifn.startswith("wl"):
                out.append((1, f"Wi-Fi ({ip})", ip))
            else:
                out.append((2, f"Ethernet ({ip})", ip))
    return [(label, ip) for _r, label, ip in sorted(out)]


def laptop_name():
    """A friendly name for the page title: the pretty hostname if set, else "<name>'s laptop"."""
    try:
        pretty = subprocess.run(["hostnamectl", "--pretty"], capture_output=True, text=True, timeout=2).stdout.strip()
        if pretty:
            return pretty
    except (OSError, subprocess.SubprocessError):
        pass
    import pwd
    who = pwd.getpwuid(os.getuid())
    first = (who.pw_gecos.split(",")[0].split() or [who.pw_name])[0]
    return f"{first.capitalize()}'s laptop"


def mood_colours():
    try:
        with open(os.path.join(os.path.expanduser("~"), ".config", "ubuntu_extension_marco", "mood",
                               "mood.json")) as f:
            m = json.load(f)
        return {"accent": m.get("accent", "#b1444d"), "light": m.get("light", "#d0606a")}
    except (OSError, ValueError):
        return {"accent": "#b1444d", "light": "#d0606a"}


def _fmt_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


def phone_name(ip):
    """'Motorola Edge 60 Pro' for a phone on the hotspot (from the hotspot guard's list)."""
    try:
        out = subprocess.run(["sudo", "-n", "/usr/local/sbin/hotspot-guard", "list"], capture_output=True,
                             text=True, timeout=3).stdout
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] == ip and parts[0] not in ("Connected", "Trusted:"):
                return " ".join(w if w.isupper() else w.capitalize() for w in parts[0].replace("_", "-").split("-"))
    except (OSError, subprocess.SubprocessError):
        pass
    return "Your phone"


def hotspot_wifi():
    """(name, password) of the laptop's hotspot when it is on, else None."""
    try:
        active = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"],
                                capture_output=True, text=True, timeout=3).stdout
        for line in active.splitlines():
            name, ctype, _dev = (line.rsplit(":", 2) + ["", ""])[:3]
            if ctype != "802-11-wireless":
                continue
            mode = subprocess.run(["nmcli", "-g", "802-11-wireless.mode", "connection", "show", name],
                                  capture_output=True, text=True, timeout=3).stdout.strip()
            if mode != "ap":
                continue
            ssid = subprocess.run(["nmcli", "-g", "802-11-wireless.ssid", "connection", "show", name],
                                  capture_output=True, text=True, timeout=3).stdout.strip()
            wifi_key = subprocess.run(["nmcli", "-s", "-g", "802-11-wireless-security.psk", "connection", "show", name],
                                 capture_output=True, text=True, timeout=3).stdout.strip()
            return ssid, wifi_key
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def wifi_qr_text(ssid, wifi_key):
    esc = lambda v: "".join("\\" + c if c in '\\;,:"' else c for c in v)
    return f"WIFI:T:WPA;S:{esc(ssid)};P:{esc(wifi_key)};;" if wifi_key else f"WIFI:T:nopass;S:{esc(ssid)};;"


# ---------- the window ----------
def main(argv):
    import gi
    # Software drawing: a simple window, and the GPU renderer costs ~65 MB more memory here.
    os.environ.setdefault("GSK_RENDERER", "cairo")
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango

    MOOD_DIR = os.path.join(GLib.get_user_config_dir(), "ubuntu_extension_marco", "mood")
    CSS = b"""
/* Phone Drop: quiet and editorial. Near-black, warm cream, the wallpaper's crimson used once
   or twice (the viewfinder corners, the live dot, the active step). Hairlines, not boxes. */
:root { --mood-accent: #b1444d; --mood-light: #d0606a; --mood-bg: #0e0c0c;
        --ink: #f2ebe3; --ink-2: rgba(242, 235, 227, 0.62); --ink-3: rgba(242, 235, 227, 0.36);
        --hair: rgba(242, 235, 227, 0.08); }
window.phonedrop { background: var(--mood-bg); color: var(--ink); font-family: "Ubuntu Sans"; }
.phonedrop headerbar { background: var(--mood-bg); box-shadow: none; border: none; min-height: 34px; }
.phonedrop headerbar windowcontrols button { min-width: 22px; min-height: 22px; padding: 0; margin: 0 2px;
  background: rgba(242, 235, 227, 0.06); color: var(--ink-2); box-shadow: none; }
.phonedrop headerbar windowcontrols button:hover { background: rgba(242, 235, 227, 0.14); color: var(--ink); }

.phonedrop .title { font-size: 25px; font-weight: 300; letter-spacing: -0.3px; color: var(--ink); }
