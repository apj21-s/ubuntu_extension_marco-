#!/usr/bin/env python3
"""Phone Drop - send files to your phone, or get files from it, by scanning a QR code.
No app needed on the phone: its camera opens a page in the browser.

  phone-drop FILE...           share these files (folders are sent as a zip)
  phone-drop                   just receive (Super+B)
  phone-drop --text FILE ...   also share the text in FILE (used by the Drop Shelf)

Running it again while it is open adds the files to the open window.

  * the phone downloads each file, or everything as one zip
  * "Upload to laptop" on the phone saves into ~/Downloads/Phone Drop/
  * works over your hotspot (best) or the same Wi-Fi / LAN
  * the link carries a random secret; it only works while this window is open and
    stops by itself after 15 minutes without use

Needs qrencode (apt) and, with ufw on, the "Phone Drop" firewall rule for TCP 47800 on the
Wi-Fi card (both added by the system part of the installer).
"""
import html
import json
import mimetypes
import os
import secrets
import shutil
import subprocess
import sys
import threading
import time
import urllib.parse
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 47800
IDLE_STOP_S = 15 * 60
INBOX = os.path.join(os.path.expanduser("~"), "Downloads", "Phone Drop")
CHUNK = 256 * 1024


# ---------- sharing state + web server (no GTK here: it runs in its own threads) ----------
def clean_name(name):
    """A safe file name for an upload: no folders, no '..', no hidden files."""
    name = os.path.basename(urllib.parse.unquote(name or "").replace("\\", "/")).strip()
    name = "".join(c for c in name if c >= " " and c not in '/\\:*?"<>|')
    name = name.lstrip(".").strip() or "file"
    return name[:180]


def unique_path(folder, name):
    stem, ext = os.path.splitext(name)
    path, n = os.path.join(folder, name), 1
    while os.path.exists(path):
        path = os.path.join(folder, f"{stem} ({n}){ext}")
        n += 1
    return path


class Share:
    """What is on offer, and what came in. Thread-safe; on_event(kind, data) is called
    from server threads (the GTK side moves it to the main loop)."""

    def __init__(self, on_event=lambda *a: None):
        self.token = secrets.token_urlsafe(8)
        self.lock = threading.Lock()
        self.items = {}  # id -> {"path", "name", "size", "dir", "sent"}
        self.texts = []
        self.on_event = on_event
        self.last_use = time.time()
        self.seen = set()  # phones (IP addresses) that opened the page
        self.version = 1   # bumped on every change; the phone page asks "anything new since N?"

    def hello(self, ip):
        if ip not in self.seen:
            self.seen.add(ip)
            self.on_event("hello", ip)

    def add(self, path):
        path = os.path.abspath(path)
        if not os.path.exists(path):
            return None
        with self.lock:
            for i, it in self.items.items():
                if it["path"] == path:
                    return i
            i = secrets.token_hex(4)
            isdir = os.path.isdir(path)
            size = sum(os.path.getsize(os.path.join(r, f)) for r, _d, fs in os.walk(path) for f in fs
                       if os.path.isfile(os.path.join(r, f))) if isdir else os.path.getsize(path)
            self.items[i] = {"path": path, "name": os.path.basename(path.rstrip("/")) + (".zip" if isdir else ""),
                             "size": size, "dir": isdir, "sent": 0}
            self.version += 1
        self.on_event("added", i)
        return i

    def add_text(self, text):
        text = text.strip()
        if text:
            with self.lock:
                if text not in self.texts:
                    self.texts.append(text)
                    self.version += 1
            self.on_event("text", None)

    def remove(self, item_id):
        with self.lock:
            if self.items.pop(item_id, None):
                self.version += 1

    def state(self):
        with self.lock:
            return {"version": self.version, "files": [{"id": i, "name": it["name"], "size": it["size"]} for i, it in self.items.items()],
                    "texts": list(self.texts)}


