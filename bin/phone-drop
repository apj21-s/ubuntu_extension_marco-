.phonedrop .step-tab { background: none; border: none; box-shadow: none; outline: none; border-radius: 0;
  padding: 2px 0 6px 0; min-height: 0; color: var(--ink-3); font-size: 12.5px; font-weight: 600;
  border-bottom: 2px solid transparent; transition: color 150ms ease, border-color 150ms ease; }
.phonedrop .step-tab:hover { color: var(--ink-2); }
.phonedrop .step-tab:checked { color: var(--ink); border-bottom-color: var(--mood-light); }

.phonedrop .qrcard { background: #f4ede5; border-radius: 6px; padding: 10px; transition: opacity 140ms ease; }
