.phonedrop .warn { font-size: 11.5px; color: var(--mood-light); }
.phonedrop button { border-radius: 99px; padding: 4px 12px; min-height: 26px; border: none; box-shadow: none;
  background: rgba(255, 255, 255, 0.08); color: var(--ink); font-size: 12px; font-weight: 600; }
.phonedrop button:hover { background: rgba(255, 255, 255, 0.14); }
