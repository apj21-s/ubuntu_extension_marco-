.phonedrop .livedot { min-width: 7px; min-height: 7px; border-radius: 99px; background: var(--ink-3); }
.phonedrop .pill.live .livedot { background: var(--mood-light); }
.phonedrop .pilltext { font-size: 12.5px; color: var(--ink-2); }
.phonedrop .pill.live .pilltext { color: var(--ink); }

.phonedrop .hair { min-height: 1px; background: var(--hair); }
.phonedrop .section { font-size: 12px; font-weight: 600; color: var(--ink-2); }
.phonedrop .empty { font-size: 12px; color: var(--ink-3); }
.phonedrop .list { background: none; }
.phonedrop .list row { background: none; padding: 7px 0; border-bottom: 1px solid var(--hair); }
.phonedrop .list row:last-child { border-bottom: none; }
.phonedrop .name { font-size: 13px; color: var(--ink); }
.phonedrop .meta { font-size: 11px; color: var(--ink-3); font-feature-settings: "tnum"; }
.phonedrop .meta.ok { color: var(--mood-light); }
.phonedrop .thumb { border-radius: 4px; }
.phonedrop .rowbtn { opacity: 0; transition: opacity 120ms ease; }
.phonedrop .list row:hover .rowbtn, .phonedrop .rowbtn:focus { opacity: 1; }

.phonedrop button.text { background: none; border: none; box-shadow: none; outline: none; padding: 2px 4px;
  min-height: 0; min-width: 0; color: var(--ink-2); font-size: 12px; font-weight: 600; border-radius: 4px; }
.phonedrop button.text:hover { color: var(--ink); background: rgba(242, 235, 227, 0.06); }
.phonedrop button.text.accent { color: var(--mood-light); }
.phonedrop button.text.accent:hover { color: var(--ink); }
.phonedrop progressbar trough { min-height: 2px; background: var(--hair); border-radius: 0; }
.phonedrop progressbar progress { min-height: 2px; background: var(--mood-light); border-radius: 0; }
.phonedrop.drop-hot { box-shadow: inset 0 0 0 2px alpha(var(--mood-light), 0.9); }
.phonedrop scrollbar slider { background: rgba(242, 235, 227, 0.14); min-width: 3px; }
"""

    def qr_texture(text, scale=6):
        png = subprocess.run(["qrencode", "-t", "PNG", "-s", str(scale), "-m", "0", "-l", "L",
                              "--foreground=0E0C0C", "--background=F5EEE6", "-o", "-", text],
                             capture_output=True, timeout=5, check=True).stdout
        loader = GdkPixbuf.PixbufLoader.new_with_type("png")
        loader.write(png)
        loader.close()
        return Gdk.Texture.new_for_pixbuf(loader.get_pixbuf())

    def notify(title, body=""):
        tool = os.path.join(os.path.expanduser("~"), ".local", "bin", "notify")
        try:
            Gio.Subprocess.new([tool if os.access(tool, os.X_OK) else "notify-send", "-i", "phone-symbolic",
                                title, body], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            pass

    def btn(label, cb, *classes):
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        b.add_css_class("text")
        for c in classes:
            b.add_css_class(c)
        b.connect("clicked", lambda *_: cb())
        return b

    def label(text, css, **kw):
        lbl = Gtk.Label(label=text, **kw)
        lbl.add_css_class(css)
        return lbl

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Phone Drop")
            self.set_default_size(392, -1)  # as tall as its content
            self.add_css_class("phonedrop")
            self.rows = {}
            self.share = Share(lambda kind, data: GLib.idle_add(self._event, kind, data))
            self.server = Server(self.share, mood_colours())
            self.addrs = []
            self.wifi = None  # (name, password) of the hotspot, read in the background

            # a plain, flat title bar in the window's own colour (just the close button)
            bar = Gtk.HeaderBar(show_title_buttons=True, decoration_layout=":close")
            bar.set_title_widget(Gtk.Box())
            self.set_titlebar(bar)

            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root.set_margin_start(28)
            root.set_margin_end(28)
            root.set_margin_bottom(22)
            scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True)
            scroll.set_child(root)
            self.set_child(scroll)

            # title, and the network as one quiet line under it
            root.append(label("Phone Drop", "title", xalign=0))
            self.addr_box = Gtk.DropDown(halign=Gtk.Align.START, tooltip_text="Network the phone uses")
            self.addr_box.add_css_class("net")
            self._addr_handler = self.addr_box.connect("notify::selected", lambda *_: self._pick_network())
            self.addrs_loaded = False
            self._net_timer = 0
            root.append(self.addr_box)

            # the two steps, then the code in a viewfinder (folds away once the phone is in)
            qr_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            qr_box.set_margin_top(24)
            self.qr_area = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.CROSSFADE,
                                        transition_duration=180, reveal_child=True)
            self.qr_area.set_child(qr_box)
            # a crossfade keeps its space: once faded out, take the area out of the layout
            self.qr_area.connect("notify::child-revealed",
                                 lambda r, _p: r.get_child_revealed() or r.set_visible(r.get_reveal_child()))
            tabs = Gtk.Box(spacing=22)
            self.tab_wifi = Gtk.ToggleButton(label="1   Join Wi-Fi")
            self.tab_page = Gtk.ToggleButton(label="2   Open link", group=self.tab_wifi, active=True)
            for t in (self.tab_wifi, self.tab_page):
                t.add_css_class("step-tab")
                t.set_focus_on_click(False)
                tabs.append(t)
            self.tab_wifi.connect("toggled", lambda b: self._show_qr())
            qr_box.append(tabs)

            frame = Gtk.Overlay(halign=Gtk.Align.CENTER, margin_top=26)
            self.qrcard = Gtk.Box(margin_top=14, margin_bottom=14, margin_start=14, margin_end=14)
            self.qrcard.add_css_class("qrcard")
            self.qr = Gtk.Picture(can_shrink=False)
            self.qrcard.append(self.qr)
            frame.set_child(self.qrcard)
            self.finder = Gtk.DrawingArea(can_target=False)
            self.finder.add_css_class("finder")
            self.finder.set_draw_func(self._draw_finder)
            frame.add_overlay(self.finder)
            qr_box.append(frame)

            self.step = label("", "step", justify=Gtk.Justification.CENTER, wrap=True, margin_top=18)
            qr_box.append(self.step)
            self.step2 = label("", "hint", justify=Gtk.Justification.CENTER, wrap=True, selectable=True,
                               margin_top=4)
            qr_box.append(self.step2)
            root.append(self.qr_area)

            # one line of status: a dot and who is connected
            self.pill = Gtk.Box(spacing=9, margin_top=22)
            self.pill.add_css_class("pill")
            dot = Gtk.Box(valign=Gtk.Align.CENTER)
            dot.add_css_class("livedot")
            self.pilltext = label("Waiting for a phone", "pilltext", xalign=0, hexpand=True)
            self.pill.append(dot)
            self.pill.append(self.pilltext)
            # laid out from the start and only faded in, so showing it never re-measures the row
            self.show_code = Gtk.Button(label="Show code", opacity=0, can_target=False)
            self.show_code.add_css_class("text")
            self.show_code.add_css_class("accent")
            self.show_code.connect("clicked", lambda *_: self._fold_qr(False))
            self.pill.append(self.show_code)
            root.append(self.pill)

            def section(title, action_label, action):
                hair = Gtk.Box(margin_top=18)
                hair.add_css_class("hair")
                head = Gtk.Box(margin_top=14, margin_bottom=4)
                head.append(label(title, "section", xalign=0, hexpand=True))
                head.append(btn(action_label, action))
                return hair, head

            # sending: a plain list; the whole window takes drops
            hair, head = section("Sending", "Add files", self._pick_files)
            root.append(hair)
            root.append(head)
            self.drop_title = label("Drop files anywhere in this window, or paste with Ctrl+V", "empty",
                                    xalign=0, wrap=True, margin_top=4)
            root.append(self.drop_title)
            self.shared = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, visible=False)
            self.shared.add_css_class("list")
            root.append(self.shared)

            # receiving
            hair, self.recv_head = section("Received", "Open folder", self._open_inbox)
            self.recv_hair = hair
            hair.set_visible(False)
            self.recv_head.set_visible(False)
            root.append(hair)
            root.append(self.recv_head)
            self.received = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, visible=False)
            self.received.add_css_class("list")
            root.append(self.received)

            foot = Gtk.Box(spacing=8, margin_top=22)
            self.status = label("", "hint", xalign=0, hexpand=True, wrap=True)
            self.stop_btn = btn("Stop", self._toggle_server)
            foot.append(self.status)
            foot.append(self.stop_btn)
            root.append(foot)

            drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
            drop.connect("drop", self._on_drop)
            drop.connect("enter", lambda *_: (self.add_css_class("drop-hot"), Gdk.DragAction.COPY)[1])
            drop.connect("leave", lambda *_: self.remove_css_class("drop-hot"))
            self.add_controller(drop)
            self.connect("close-request", self._on_close)
            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", self._on_key)
            self.add_controller(keys)

            self._load_addresses()
            threading.Thread(target=self._read_hotspot, daemon=True).start()
            # cable plugged/unplugged, hotspot on/off: follow it live
            self._netmon = Gio.NetworkMonitor.get_default()
            self._netmon.connect("network-changed", self._network_changed)
            self.status.set_label("Stops by itself after 15 minutes without use.")
            GLib.timeout_add_seconds(30, self._idle_check)

        # ----- network + QR -----
        def _load_addresses(self):
            """Read the networks again (at start and whenever they change) without
            disturbing anything that still works."""
            old_ip, old_label = self.server.ip, self._label_of(self.server.ip)
            had_hotspot = any(lbl.startswith("Hotspot") for lbl, _ip in self.addrs)
            self.addrs = addresses()
            ips = [ip for _l, ip in self.addrs]
            if self.server.running or not self.addrs_loaded:
                self.server.sync(ips)
            hotspot = next((ip for lbl, ip in self.addrs if lbl.startswith("Hotspot")), None)
            if old_ip in ips and not (hotspot and not had_hotspot and not self.share.seen):
                pick = old_ip                     # keep what is shown
            elif hotspot and (not had_hotspot or old_ip not in ips):
                pick = hotspot                    # hotspot just came on: phones use that
            else:
                pick = ips[0] if ips else None
            self.server.ip = pick
            self.addr_box.handler_block(self._addr_handler)
            self.addr_box.set_model(Gtk.StringList.new([lbl.split(" (")[0] for lbl, _ip in self.addrs] or ["No network"]))
            self.addr_box.set_selected(ips.index(pick) if pick in ips else 0)
            self.addr_box.handler_unblock(self._addr_handler)
            self.addr_box.set_visible(len(self.addrs) > 1)
            if self.addrs_loaded and pick != old_ip:
                now = self._label_of(pick) or "no network"
                self.status.set_label(f"{old_label} is gone - now using {now}" if old_label and old_ip not in ips
                                      else f"Now using {now}")
            first = not self.addrs_loaded
            self.addrs_loaded = True
            if hotspot and not had_hotspot and not first:
                threading.Thread(target=self._read_hotspot, daemon=True).start()
            # the first code appears at once, so the window measures its full height
            self._show_qr(animate=pick != old_ip and not first)

        def _label_of(self, ip):
            return next((lbl.split(" (")[0] for lbl, i in self.addrs if i == ip), None)

        def _pick_network(self):
            """The user chose another network: only the code changes."""
            i = self.addr_box.get_selected()
            if i < len(self.addrs) and self.addrs[i][1] != self.server.ip:
                self.server.ip = self.addrs[i][1]
                self._show_qr(animate=True)

        def _network_changed(self, *_):
            if self._net_timer:
                GLib.source_remove(self._net_timer)
            # NetworkManager reports several steps per change: wait until it settles
            self._net_timer = GLib.timeout_add(1200, self._network_settled)

        def _network_settled(self):
            self._net_timer = 0
            self._load_addresses()
            return GLib.SOURCE_REMOVE

        def _read_hotspot(self):
            """In the background: hotspot name/password, and whether a phone is already on it."""
            wifi = hotspot_wifi()
            phones = 0
            try:
                out = subprocess.run(["ip", "neigh", "show", "dev", "wlo1"], capture_output=True, text=True,
                                     timeout=3).stdout
                phones = sum(1 for line in out.splitlines() if "REACHABLE" in line or "STALE" in line)
            except (OSError, subprocess.SubprocessError):
                pass
            GLib.idle_add(self._hotspot_ready, wifi, phones)

        def _hotspot_ready(self, wifi, phones):
            self.wifi = wifi
            # nobody on the hotspot yet: start with "join the hotspot"
            if wifi and self._on_hotspot() and not phones and not self.share.seen:
                self.tab_wifi.set_active(True)
            self._show_qr()
            return GLib.SOURCE_REMOVE

        def _draw_finder(self, area, cr, w, h):
            """Four thin camera-viewfinder corners around the code."""
            c = area.get_color()
            cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
            cr.set_line_width(2)
            L, m = 22, 1
            for x, y, dx, dy in ((m, m, 1, 1), (w - m, m, -1, 1), (m, h - m, 1, -1), (w - m, h - m, -1, -1)):
                cr.move_to(x, y + dy * L)
                cr.line_to(x, y)
                cr.line_to(x + dx * L, y)
            cr.stroke()

        def _fold_qr(self, fold):
            if not fold:
                self.qr_area.set_visible(True)
            self.qr_area.set_reveal_child(not fold)
            self.show_code.set_opacity(1 if fold else 0)
            self.show_code.set_can_target(fold)

        def _on_key(self, _c, keyval, _code, state):
            ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
            if keyval == Gdk.KEY_Escape:
                self.close()
                return True
            if ctrl and keyval in (Gdk.KEY_v, Gdk.KEY_V):
                self._paste()
                return True
            return False

        def _paste(self):
            """Ctrl+V: share whatever was copied - files, a picture (screenshot) or text."""
            cb = self.get_display().get_clipboard()
            fmts = cb.get_formats()

            def got_files(c, res):
                try:
                    self.add_paths([f.get_path() for f in c.read_value_finish(res).get_files() if f.get_path()])
                except GLib.Error:
                    pass

            def got_texture(c, res):
                try:
                    tex = c.read_texture_finish(res)
                except GLib.Error:
                    return
                folder = os.path.join(GLib.get_user_runtime_dir(), "phone-drop")
                os.makedirs(folder, exist_ok=True)
                path = os.path.join(folder, time.strftime("Pasted %Y-%m-%d %H-%M-%S.png"))
                tex.save_to_png(path)
                self.add_paths([path])

            def got_text(c, res):
                try:
                    text = c.read_text_finish(res)
                except GLib.Error:
                    return
                if text:
                    self.share.add_text(text)
                    self.status.set_label("Text shared - it's on the phone page")

            if fmts.contain_gtype(Gdk.FileList):
                cb.read_value_async(Gdk.FileList, GLib.PRIORITY_DEFAULT, None, got_files)
            elif fmts.contain_gtype(Gdk.Texture):
                cb.read_texture_async(None, got_texture)
            else:
                cb.read_text_async(None, got_text)

        def _on_hotspot(self):
            i = self.addr_box.get_selected()
            return bool(self.addrs) and i < len(self.addrs) and self.addrs[i][0].startswith("Hotspot")

        def _show_qr(self, animate=False):
            if animate:  # fade out, swap, fade back in
                self.qrcard.add_css_class("fading")
                GLib.timeout_add(140, lambda: (self._show_qr(), self.qrcard.remove_css_class("fading"))[1] and False)
                return
            wifi_step = self.tab_wifi.get_active()
            self.tab_wifi.set_visible(bool(self.wifi) and self._on_hotspot())
            try:
                if wifi_step and self.wifi:
                    ssid, wifi_key = self.wifi
                    self.qr.set_paintable(qr_texture(wifi_qr_text(ssid, wifi_key), 6))
                    self.step.set_label(f"Join “{ssid}”")
                    self.step2.set_label(f"password   {wifi_key}" if wifi_key else "no password")
                    self.step2.remove_css_class("hint")
                    self.step2.add_css_class("pass")
                elif self.server.httpd:
                    self.qr.set_paintable(qr_texture(self.server.url, 6))
                    self.step.set_label("Point the phone's camera here")
                    net = f"“{self.wifi[0]}”" if self.wifi and self._on_hotspot() else "the same Wi-Fi"
                    self.step2.set_label(f"The phone needs to be on {net}.  Page won't load?\n"
                                         "Turn off its mobile data and scan again.")
                    self.step2.remove_css_class("pass")
                    self.step2.add_css_class("hint")
                else:
                    self.qr.set_paintable(None)
                    self.step.set_label("Not connected to any network")
                    self.step2.set_label("Turn on the hotspot (Super+Shift+H) or connect to Wi-Fi.")
            except (OSError, subprocess.SubprocessError, GLib.Error):
                self.qr.set_paintable(None)
                self.step.set_label("QR codes need qrencode: sudo apt install qrencode")
                self.step2.set_label(self.server.url if self.server.httpd else "")

        def _toggle_server(self):
            if self.server.running:
                self.server.stop()
                self.qrcard.set_opacity(0.2)
                self.stop_btn.set_label("Start again")
                self.status.set_label("Stopped. The link no longer works.")
            else:
                self.qrcard.set_opacity(1)
                self.server.sync([ip for _l, ip in self.addrs])
                self.stop_btn.set_label("Stop")
                self.status.set_label("Stops by itself after 15 minutes without use.")
                self._show_qr()

        def _idle_check(self):
            if self.server.running and time.time() - self.share.last_use > IDLE_STOP_S:
                self._toggle_server()
                self.status.set_label("Stopped after 15 minutes without use.")
            return GLib.SOURCE_CONTINUE

        def _on_close(self, *_):
            self.server.stop()
            return False

        # ----- files -----
        def add_paths(self, paths):
            for p in paths:
                self.share.add(p)

        def _on_drop(self, _t, value, *_):
            self.remove_css_class("drop-hot")
            self.add_paths([f.get_path() for f in value.get_files() if f.get_path()])
            return True

        def _pick_files(self):
            def done(d, res):
                try:
                    files = d.open_multiple_finish(res)
                except GLib.Error:
                    return
                self.add_paths([files.get_item(i).get_path() for i in range(files.get_n_items())])
            Gtk.FileDialog(title="Send to the phone").open_multiple(self, None, done)

        def _open_inbox(self):
            os.makedirs(INBOX, exist_ok=True)
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(INBOX).get_uri(),
                                               self.get_display().get_app_launch_context())

        def _icon(self, path, size=30):
            try:
                if (mimetypes.guess_type(path)[0] or "").startswith("image/"):  # photos: a small preview
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
                    pic = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(pb))
                    pic.set_size_request(size, size)
                    pic.add_css_class("thumb")
                    return pic
                info = Gio.File.new_for_path(path).query_info("standard::icon", Gio.FileQueryInfoFlags.NONE, None)
                img = Gtk.Image.new_from_gicon(info.get_icon())
            except GLib.Error:
                img = Gtk.Image.new_from_icon_name("text-x-generic")
            img.set_pixel_size(size - 4)
            return img

        def _row(self, name, sub, path, buttons):
            row = Gtk.ListBoxRow()
            box = Gtk.Box(spacing=10)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True, valign=Gtk.Align.CENTER)
            text.append(label(name, "name", xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE))
            meta = label(sub, "meta", xalign=0)
            bar = Gtk.ProgressBar(visible=False)
            text.append(meta)
            text.append(bar)
            box.append(self._icon(path))
            box.append(text)
            for b in buttons:
                b.add_css_class("rowbtn")
                box.append(b)
            row.set_child(box)
            return row, meta, bar

        def _connected(self, who):
            first = not self.pill.has_css_class("live")
            self.pill.add_css_class("live")
            self.finder.add_css_class("live")
            self.pilltext.set_label(f"{who} connected")
            if first:  # the code did its job: fold it away and give the files the room
                GLib.timeout_add(900, lambda: self._fold_qr(True) or False)
            return GLib.SOURCE_REMOVE

        def _event(self, kind, data):
            if kind == "hello":
                ip = data
                self._connected("Phone")
                # the name lookup runs a helper: keep it off the main loop
                threading.Thread(target=lambda: GLib.idle_add(self._connected, phone_name(ip)),
                                 daemon=True).start()
            elif kind == "added":
                it = self.share.items[data]
                rm = btn("Remove", lambda: None)
                row, meta, bar = self._row(it["name"], f"{_fmt_size(it['size'])}  ·  on the phone's page", it["path"], [rm])
                rm.connect("clicked", lambda *_: self._remove(data, row))
                self.drop_title.set_visible(False)
                self.rows[data] = (meta, bar)
                self.shared.append(row)
                self.shared.set_visible(True)
            elif kind == "progress":
                item_id, sent, size = data
                if item_id in self.rows:
                    meta, bar = self.rows[item_id]
                    bar.set_visible(True)
                    bar.set_fraction(min(1.0, sent / max(1, size)))
                    meta.remove_css_class("ok")
                    meta.set_label(f"Sending · {int(100 * sent / max(1, size))}%")
            elif kind == "done":
                if data in self.rows:
                    meta, bar = self.rows[data]
                    bar.set_visible(False)
                    meta.set_label("Downloaded by the phone")
                    meta.add_css_class("ok")
            elif kind == "received":
                path = data
                uri = Gio.File.new_for_path(path).get_uri()
                ctx = self.get_display().get_app_launch_context()
                open_b = btn("Open", lambda: Gio.AppInfo.launch_default_for_uri(uri, ctx))
                show_b = btn("Show", lambda: Gio.AppInfo.create_from_commandline(
                    "nautilus --select", "Files", Gio.AppInfoCreateFlags.SUPPORTS_URIS).launch_uris([uri], ctx))
                for b in (open_b, show_b):
                    b.set_valign(Gtk.Align.CENTER)
                row, _m, _b = self._row(os.path.basename(path), f"{_fmt_size(os.path.getsize(path))}  ·  {time.strftime('%H:%M')}",
                                        path, [open_b, show_b])
                self.received.prepend(row)
                self.received.set_visible(True)
                self.recv_head.set_visible(True)
                self.recv_hair.set_visible(True)
                notify("Received from your phone", os.path.basename(path))
            return GLib.SOURCE_REMOVE

        def _remove(self, item_id, row):
            self.share.remove(item_id)
            self.rows.pop(item_id, None)
            self.shared.remove(row)
            if not self.share.items:
                self.shared.set_visible(False)
                self.drop_title.set_visible(True)

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="io.arco.PhoneDrop", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.win = None

        def do_startup(self):
            Gtk.Application.do_startup(self)
            disp = Gdk.Display.get_default()
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_display(disp, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            mood = Gtk.CssProvider()  # Wallpaper Mood colours, if any
            try:
                with open(os.path.join(MOOD_DIR, "gtk.css")) as f:
                    mood.load_from_string(f.read())
                Gtk.StyleContext.add_provider_for_display(disp, mood, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            except OSError:
                pass

        def do_command_line(self, cmdline):
            if not self.win:
                self.win = Window(self)
            args = cmdline.get_arguments()[1:]
            paths, i = [], 0
            while i < len(args):
                if args[i] == "--text" and i + 1 < len(args):
                    try:
                        with open(cmdline.create_file_for_arg(args[i + 1]).get_path()) as f:
                            for chunk in f.read().split("\0"):
                                self.win.share.add_text(chunk)
                    except OSError:
                        pass
                    i += 2
                    continue
                p = cmdline.create_file_for_arg(args[i]).get_path()
                if p:
                    paths.append(p)
                i += 1
            self.win.add_paths(paths)
            self.win.present()
            return 0

    return App().run(argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
