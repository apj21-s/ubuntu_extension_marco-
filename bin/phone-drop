.phonedrop.drop-hot { box-shadow: inset 0 0 0 2px var(--mood-light); }
"""

    def _value(gtype, obj):
        v = GObject.Value()
        v.init(gtype)
        v.set_boxed(obj)
        return v

    def notify(title, body=""):
        tool = os.path.join(os.path.expanduser("~"), ".local", "bin", "notify")
        argv_ = [tool if os.access(tool, os.X_OK) else "notify-send", "-i", "phone-symbolic", title, body]
        try:
            Gio.Subprocess.new(argv_, Gio.SubprocessFlags.NONE)
        except GLib.Error:
            pass

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Phone Drop")
            self.set_default_size(420, 640)
            self.add_css_class("phonedrop")
            self.rows = {}  # item id -> (meta label, progress bar)
            self.share = Share(lambda kind, data: GLib.idle_add(self._event, kind, data))
            self.server = Server(self.share, mood_colours())
            self.addrs = []
            self.connected = False

            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            for m in ("top", "bottom", "start", "end"):
                getattr(root, f"set_margin_{m}")(18)
            scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            scroll.set_child(root)
            self.set_child(scroll)

            head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            t = Gtk.Label(label="Phone Drop", xalign=0)
            t.add_css_class("title")
            self.sub = Gtk.Label(label="Scan with your phone's camera", xalign=0)
            self.sub.add_css_class("sub")
            head.append(t)
            head.append(self.sub)
            root.append(head)

            card = Gtk.Box(halign=Gtk.Align.CENTER)
            card.add_css_class("qrcard")
            self.qr = Gtk.Picture(can_shrink=False)
            card.append(self.qr)
            root.append(card)

            self.url = Gtk.Label(selectable=True, wrap=True, wrap_mode=Pango.WrapMode.CHAR, justify=Gtk.Justification.CENTER)
            self.url.add_css_class("url")
            root.append(self.url)

            pick = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
            self.addr_box = Gtk.DropDown()
            self.addr_box.connect("notify::selected", lambda *_: self._restart())
            copy = Gtk.Button(label="Copy link")
            copy.connect("clicked", lambda *_: (self.get_display().get_clipboard().set(self.server.url),
                                                self.sub.set_label("Link copied")))
            pick.append(self.addr_box)
            pick.append(copy)
            root.append(pick)
            self.warn = Gtk.Label(wrap=True, xalign=0, visible=False)
            self.warn.add_css_class("warn")
            root.append(self.warn)

            sh = Gtk.Box(spacing=8)
            l1 = Gtk.Label(label="Sharing", xalign=0, hexpand=True)
            l1.add_css_class("section")
            add = Gtk.Button(label="Add files")
            add.add_css_class("small")
            add.connect("clicked", lambda *_: self._pick_files())
            sh.append(l1)
            sh.append(add)
            root.append(sh)
            self.shared = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            self.shared.add_css_class("list")
            self.shared.set_placeholder(self._empty("Drop files here, or press Add files"))
            root.append(self.shared)

            l2 = Gtk.Label(label="Received from the phone", xalign=0)
            l2.add_css_class("section")
            root.append(l2)
            self.received = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            self.received.add_css_class("list")
            self.received.set_placeholder(self._empty("On the phone: Upload to laptop"))
            root.append(self.received)

            foot = Gtk.Box(spacing=8, margin_top=6)
            self.status = Gtk.Label(xalign=0, hexpand=True, wrap=True)
            self.status.add_css_class("sub")
            self.stop_btn = Gtk.Button(label="Stop")
            self.stop_btn.add_css_class("accent")
            self.stop_btn.connect("clicked", lambda *_: self._toggle_server())
            foot.append(self.status)
            foot.append(self.stop_btn)
            root.append(foot)

            drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
            drop.connect("drop", self._on_drop)
            drop.connect("enter", lambda *_: (self.add_css_class("drop-hot"), Gdk.DragAction.COPY)[1])
            drop.connect("leave", lambda *_: self.remove_css_class("drop-hot"))
            self.add_controller(drop)
            self.connect("close-request", self._on_close)

            self._load_addresses()
            GLib.timeout_add_seconds(30, self._idle_check)
            GLib.timeout_add_seconds(45, self._firewall_hint)

        def _empty(self, text):
            lbl = Gtk.Label(label=text)
            lbl.add_css_class("empty")
            return lbl

        # ----- server / address -----
        def _load_addresses(self):
            self.addrs = addresses()
            labels = [a[0] for a in self.addrs] or ["No network"]
            self.addr_box.set_model(Gtk.StringList.new(labels))
            self.addr_box.set_selected(0)
            self._restart()

        def _restart(self):
            i = self.addr_box.get_selected()
            if not self.addrs or i >= len(self.addrs):
                self.server.stop()
                self.qr.set_paintable(None)
                self.url.set_label("")
                self.status.set_label("Not connected to any network. Turn on the hotspot or Wi-Fi.")
                return
            if self.server.httpd and self.server.ip == self.addrs[i][1]:
                return  # already serving there (picking the first address also fires this)
            try:
                self.server.start(self.addrs[i][1])
            except OSError as e:
                self.status.set_label(f"Can't start: {e.strerror}")
                return
            self._render_qr()
            self.stop_btn.set_label("Stop")
            self.status.set_label("Waiting for your phone…  Stops by itself after 15 idle minutes.")

        def _render_qr(self):
            url = self.server.url
            self.url.set_label(url)
            try:
                png = subprocess.run(["qrencode", "-t", "PNG", "-s", "7", "-m", "1", "-l", "M",
                                      "--foreground=0E0C0C", "--background=F5EEE6", "-o", "-", url],
                                     capture_output=True, timeout=5).stdout
                loader = GdkPixbuf.PixbufLoader.new_with_type("png")
                loader.write(png)
                loader.close()
                self.qr.set_paintable(Gdk.Texture.new_for_pixbuf(loader.get_pixbuf()))
            except (OSError, GLib.Error, subprocess.SubprocessError):
                self.qr.set_paintable(None)
                self.warn.set_label("QR code needs qrencode:  sudo apt install qrencode   (the link above works too)")
                self.warn.set_visible(True)

        def _toggle_server(self):
            if self.server.httpd:
                self.server.stop()
                self.qr.set_opacity(0.15)
                self.stop_btn.set_label("Start again")
                self.status.set_label("Stopped. The link no longer works.")
            else:
                self.qr.set_opacity(1)
                self._restart()

        def _idle_check(self):
            if self.server.httpd and time.time() - self.share.last_use > IDLE_STOP_S:
                self._toggle_server()
                self.status.set_label("Stopped after 15 minutes without use.")
            return GLib.SOURCE_CONTINUE

        def _firewall_hint(self):
            if self.server.httpd and not self.connected:
                self.warn.set_label("Phone can't open the page? Make sure it's on the same Wi-Fi or your hotspot. "
                                    "With the firewall on, the system part of the installer adds the Phone Drop rule.")
                self.warn.set_visible(True)
            return GLib.SOURCE_REMOVE

        def _on_close(self, *_):
            self.server.stop()
            return False

        # ----- files -----
        def add_paths(self, paths):
            for p in paths:
                self.share.add(p)

        def _on_drop(self, _t, value, *_):
            self.remove_css_class("drop-hot")
            self.add_paths([f.get_path() for f in value.get_files() if f.get_path()])
            return True

        def _pick_files(self):
            dlg = Gtk.FileDialog(title="Share with the phone")

            def done(d, res):
                try:
                    files = d.open_multiple_finish(res)
                except GLib.Error:
                    return
                self.add_paths([files.get_item(i).get_path() for i in range(files.get_n_items())])

            dlg.open_multiple(self, None, done)

        def _file_row(self, name, sub, path, buttons):
            row = Gtk.ListBoxRow()
            box = Gtk.Box(spacing=10)
            try:
                info = Gio.File.new_for_path(path).query_info("standard::icon", Gio.FileQueryInfoFlags.NONE, None)
                icon = Gtk.Image.new_from_gicon(info.get_icon())
            except GLib.Error:
                icon = Gtk.Image.new_from_icon_name("text-x-generic")
            icon.set_pixel_size(26)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            n = Gtk.Label(label=name, xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            n.add_css_class("name")
            meta = Gtk.Label(label=sub, xalign=0)
            meta.add_css_class("meta")
            bar = Gtk.ProgressBar(visible=False)
            text.append(n)
            text.append(meta)
            text.append(bar)
            box.append(icon)
            box.append(text)
            for b in buttons:
                box.append(b)
            row.set_child(box)
            return row, meta, bar

        def _event(self, kind, data):
            if kind == "added":
                it = self.share.items[data]
                rm = Gtk.Button(label="✕")
                rm.add_css_class("small")
                row, meta, bar = self._file_row(it["name"], f"{_fmt_size(it['size'])} · waiting", it["path"], [rm])
                rm.connect("clicked", lambda *_: self._remove(data, row))
                self.rows[data] = (meta, bar)
                self.shared.append(row)
            elif kind == "progress":
                self.connected = True
                self.warn.set_visible(False)
                item_id, sent, size = data
                if item_id in self.rows:
                    meta, bar = self.rows[item_id]
                    bar.set_visible(True)
                    bar.set_fraction(min(1.0, sent / max(1, size)))
                    meta.remove_css_class("ok")
                    meta.set_label(f"Sending {int(100 * sent / max(1, size))}%")
                self.status.set_label("Phone connected")
            elif kind == "done":
                if data in self.rows:
                    meta, bar = self.rows[data]
                    bar.set_visible(False)
                    meta.set_label("Sent to the phone ✓")
                    meta.add_css_class("ok")
            elif kind == "received":
                self.connected = True
                self.warn.set_visible(False)
                path = data
                open_b = Gtk.Button(label="Open")
                open_b.add_css_class("small")
                show_b = Gtk.Button(label="Show")
                show_b.add_css_class("small")
                uri = Gio.File.new_for_path(path).get_uri()
                ctx = self.get_display().get_app_launch_context()
                open_b.connect("clicked", lambda *_: Gio.AppInfo.launch_default_for_uri(uri, ctx))
                show_b.connect("clicked", lambda *_: Gio.AppInfo.create_from_commandline(
                    "nautilus --select", "Files", Gio.AppInfoCreateFlags.SUPPORTS_URIS).launch_uris([uri], ctx))
                row, _m, _b = self._file_row(os.path.basename(path), f"{_fmt_size(os.path.getsize(path))} · just now",
                                             path, [open_b, show_b])
                self.received.prepend(row)
                self.status.set_label("Phone connected")
                notify("Received from your phone", os.path.basename(path))
            return GLib.SOURCE_REMOVE

        def _remove(self, item_id, row):
            with self.share.lock:
                self.share.items.pop(item_id, None)
            self.rows.pop(item_id, None)
            self.shared.remove(row)

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="io.arco.PhoneDrop", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.win = None

        def do_startup(self):
            Gtk.Application.do_startup(self)
            disp = Gdk.Display.get_default()
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_display(disp, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            mood = Gtk.CssProvider()  # Wallpaper Mood colours, if any
            try:
                with open(os.path.join(MOOD_DIR, "gtk.css")) as f:
                    mood.load_from_string(f.read())
                Gtk.StyleContext.add_provider_for_display(disp, mood, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            except OSError:
                pass

        def do_command_line(self, cmdline):
            if not self.win:
                self.win = Window(self)
            args = cmdline.get_arguments()[1:]
            paths, i = [], 0
            while i < len(args):
                if args[i] == "--text" and i + 1 < len(args):
                    try:
                        with open(cmdline.create_file_for_arg(args[i + 1]).get_path()) as f:
                            for chunk in f.read().split("\0"):
                                self.win.share.add_text(chunk)
                    except OSError:
                        pass
                    i += 2
                    continue
                p = cmdline.create_file_for_arg(args[i]).get_path()
                if p:
                    paths.append(p)
                i += 1
            self.win.add_paths(paths)
            self.win.present()
            return 0

    return App().run(argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
