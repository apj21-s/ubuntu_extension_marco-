class _ZipStream:
    """A write-only file for zipfile that sends straight to the phone (no temp file)."""

    def __init__(self, out, count):
        self.out, self.count, self.pos = out, count, 0

    def write(self, b):
        self.out.write(b)
        self.pos += len(b)
        self.count(len(b))
        return len(b)

    def tell(self):
        return self.pos

    def flush(self):
        self.out.flush()


def make_handler(share, colours):
    class Handler(BaseHTTPRequestHandler):
        server_version = "PhoneDrop"
        protocol_version = "HTTP/1.1"

        def log_message(self, *_a):
            pass

        def _route(self):
            """('page'|'state'|'file'|'zip'|'up', arg) for a valid token, else None."""
            parts = urllib.parse.urlsplit(self.path)
            seg = parts.path.split("/")
            # /t/<token>/<rest>
            if len(seg) < 3 or seg[1] != "t" or not secrets.compare_digest(seg[2], share.token):
                return None, None, parts
            rest = seg[3:]
            share.last_use = time.time()
            if rest in ([], [""]):
                return "page", None, parts
            if rest == ["state.json"]:
                return "state", None, parts
            if rest == ["all.zip"]:
                return "zip", None, parts
            if rest == ["up"]:
                return "up", None, parts
            if len(rest) == 2 and rest[0] == "f":
                return "file", rest[1], parts
            return None, None, parts

        def _send(self, code, body=b"", ctype="text/plain; charset=utf-8", extra=None):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _not_found(self):
            self._send(404, b"Not found")

        def do_GET(self):
            kind, arg, _parts = self._route()
            if kind == "page":
                body = PAGE % dict(colours, host=html.escape(os.uname().nodename))
                return self._send(200, body.encode(), "text/html; charset=utf-8")
            if kind == "state":
                return self._send(200, json.dumps(share.state()).encode(), "application/json")
            if kind == "file":
                with share.lock:
                    item = share.items.get(arg)
                if not item:
                    return self._not_found()
                return self._zip([item], item["name"]) if item["dir"] else self._file(arg, item)
            if kind == "zip":
                with share.lock:
                    items = list(share.items.values())
                return self._zip(items, "Phone Drop.zip") if items else self._not_found()
            return self._not_found()

        do_HEAD = do_GET

        def _disposition(self, name):
            ascii_name = name.encode("ascii", "replace").decode().replace('"', "")
            return f'attachment; filename="{ascii_name}"; filename*=UTF-8\'\'{urllib.parse.quote(name)}'

        def _file(self, item_id, item):
            try:
                f = open(item["path"], "rb")
            except OSError:
                return self._not_found()
            with f:
                size = os.fstat(f.fileno()).st_size
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Content-Length", str(size))
                self.send_header("Content-Disposition", self._disposition(item["name"]))
                self.end_headers()
                if self.command == "HEAD":
                    return
                sent = 0
                while chunk := f.read(CHUNK):
                    self.wfile.write(chunk)
                    sent += len(chunk)
                    share.last_use = time.time()
                    share.on_event("progress", (item_id, sent, size))
                share.on_event("done", item_id)

        def _zip(self, items, name):
            self.send_response(200)
            self.send_header("Content-Type", "application/zip")
            self.send_header("Content-Disposition", self._disposition(name))
            self.send_header("Connection", "close")  # length unknown: the end of the stream ends it
            self.end_headers()
            self.close_connection = True
            if self.command == "HEAD":
                return
            total = sum(i["size"] for i in items) or 1
            done = [0]

            def count(n):
                done[0] += n
                share.last_use = time.time()
                for it_id, it in list(share.items.items()):
                    if it in items:
                        share.on_event("progress", (it_id, min(done[0], total), total))

            with zipfile.ZipFile(_ZipStream(self.wfile, count), "w", zipfile.ZIP_STORED, allowZip64=True) as z:
                for it in items:
                    if it["dir"]:
                        base = os.path.dirname(it["path"].rstrip("/"))
                        for root, _dirs, files in os.walk(it["path"]):
                            for fn in files:
                                p = os.path.join(root, fn)
                                if os.path.isfile(p):
                                    z.write(p, os.path.relpath(p, base))
                    elif os.path.isfile(it["path"]):
                        z.write(it["path"], it["name"])
            for it_id, it in list(share.items.items()):
                if it in items:
                    share.on_event("done", it_id)

        def do_PUT(self):
            kind, _arg, parts = self._route()
            if kind != "up":
                return self._not_found()
            try:
                length = int(self.headers.get("Content-Length", "-1"))
            except ValueError:
                length = -1
            if length < 0:
                return self._send(411, b"Length required")
            os.makedirs(INBOX, exist_ok=True)
            if shutil.disk_usage(INBOX).free < length + 200 * 1024 * 1024:
                return self._send(507, b"Not enough space on the laptop")
            name = clean_name(urllib.parse.parse_qs(parts.query).get("name", ["file"])[0])
            tmp = os.path.join(INBOX, f".incoming-{secrets.token_hex(6)}")
            left = length
            try:
                with open(tmp, "wb") as f:
                    while left > 0:
                        chunk = self.rfile.read(min(CHUNK, left))
                        if not chunk:
                            break
                        f.write(chunk)
                        left -= len(chunk)
                        share.last_use = time.time()
                if left:
                    raise OSError("upload cut short")
                final = unique_path(INBOX, name)
                os.replace(tmp, final)
            except OSError:
                try:
                    os.remove(tmp)
                except OSError:
                    pass
                return self._send(500, b"Upload failed")
            share.on_event("received", final)
            self._send(200, b"ok")

    return Handler


class Server:
    def __init__(self, share, colours):
        self.share, self.colours = share, colours
        self.httpd = None
        self.ip = None

    def start(self, ip):
        self.stop()
        self.httpd = ThreadingHTTPServer((ip, PORT), make_handler(self.share, self.colours))
        self.httpd.daemon_threads = True
        self.ip = ip
        threading.Thread(target=self.httpd.serve_forever, kwargs={"poll_interval": 1.0}, daemon=True).start()

    def stop(self):
        if self.httpd:
            self.httpd.shutdown()
            self.httpd.server_close()
            self.httpd = None

    @property
    def url(self):
        return f"http://{self.ip}:{PORT}/t/{self.share.token}/"


def addresses():
    """[(label, ip)] best first: hotspot, Wi-Fi, Ethernet. VPN/docker/virtual ones are left out."""
    try:
        data = json.loads(subprocess.run(["ip", "-j", "-4", "addr"], capture_output=True, text=True,
                                         timeout=3).stdout or "[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    out = []
    for link in data:
        ifn = link.get("ifname", "")
        if ifn == "lo" or ifn.startswith(("docker", "br-", "veth", "virbr", "tun", "tap", "wg", "proton", "ipv6")):
            continue
        for a in link.get("addr_info", []):
            ip = a.get("local", "")
            if not ip or ip.startswith("169.254."):
                continue
            if ifn.startswith("wl") and ip.startswith("10.42."):
                out.append((0, f"Hotspot ({ip})", ip))
            elif ifn.startswith("wl"):
                out.append((1, f"Wi-Fi ({ip})", ip))
            else:
                out.append((2, f"Ethernet ({ip})", ip))
    return [(label, ip) for _r, label, ip in sorted(out)]


def mood_colours():
    try:
        with open(os.path.join(os.path.expanduser("~"), ".config", "ubuntu_extension_marco", "mood",
                               "mood.json")) as f:
            m = json.load(f)
        return {"accent": m.get("accent", "#b1444d"), "light": m.get("light", "#d0606a")}
    except (OSError, ValueError):
        return {"accent": "#b1444d", "light": "#d0606a"}


def _fmt_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


