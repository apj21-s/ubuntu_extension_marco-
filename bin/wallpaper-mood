#!/usr/bin/env python3
"""Wallpaper Mood - the desktop's accent colour follows the wallpaper.

  wallpaper-mood           work out the colours from the current wallpaper once
                           (the Wallpaper Mood extension runs this whenever the wallpaper changes)
  wallpaper-mood --watch   keep running and redo it on changes (for use without the extension)
  wallpaper-mood fixed     go back to the fixed "I Found You" crimson (and stay there)
  wallpaper-mood auto      follow the wallpaper again
  wallpaper-mood show      print the current colours

It picks the wallpaper's most vivid colour, then builds the same family of shades the
theme always used (#b1444d core, #d0606a light, #8e2a32 dark, ...) in that hue, keeping
the brightness the theme was designed around so text stays readable.

Writes ~/.config/ubuntu_extension_marco/mood/:
  mood.json   the colours (read by the Charging Splash and Drag Switch extensions)
  gtk.css     CSS variables for the Drop Shelf and File Finder (they reload it live)
  shell.css   overrides for the desktop extensions (loaded live by wallpaper-mood@arco)
and sets the dock's running-dot and background colours.
"""
import colorsys
import json
import math
import os
import sys

import gi
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, Gio, GLib  # noqa: E402

OUT = os.path.join(GLib.get_user_config_dir(), "ubuntu_extension_marco", "mood")
MODE_FILE = os.path.join(OUT, "mode")
DOCK = "org.gnome.shell.extensions.dash-to-dock"

# The original "I Found You" palette: the default, and the model every mood copies.
FIXED = {"accent": "#b1444d", "light": "#d0606a", "dark": "#8e2a32", "deep": "#7a2024",
         "pale": "#e7a0a7", "vivid": "#ff2d55", "vivid_deep": "#dc143c", "bg": "#0e0c0c"}

SHELL_CSS = """/* Wallpaper Mood: generated by ~/.local/bin/wallpaper-mood - do not edit.
   Same rules as the extensions' own stylesheets, in the wallpaper's colour. */

/* Dot Badges */
#dashtodockContainer StLabel.notification-badge,
.overview-tile StLabel.notification-badge,
.icon-grid StLabel.notification-badge {
  background-color: @accent@;
  background-gradient-start: @light@;
  background-gradient-end: @dark@;
  border: 1px solid rgba(@bg_rgb@, 0.9);
  box-shadow: 0 0 9px 2px rgba(@accent_rgb@, 0.55);
}

/* Click Ripple */
.click-ripple-ring {
  border: 2px solid rgba(@vivid_rgb@, 0.95);
  box-shadow: 0 0 10px 1px rgba(@vivid_deep_rgb@, 0.55);
}
.click-ripple-ring.secondary {
  border-color: rgba(244, 244, 244, 0.9);
  box-shadow: 0 0 10px 1px rgba(255, 255, 255, 0.35);
}
.click-ripple-flash { background-color: rgba(@vivid_deep_rgb@, 0.32); }
.click-ripple-flash.secondary { background-color: rgba(255, 255, 255, 0.22); }
.click-ripple-hold {
  background-color: rgba(@vivid_rgb@, 0.9);
  box-shadow: 0 0 8px 1px rgba(@vivid_deep_rgb@, 0.6);
}

/* Charging Splash */
.csp-halo { background-color: rgba(@bg_rgb@, 0.55); }
.csp-halo.csp-on { box-shadow: 0 0 46px rgba(@accent_rgb@, 0.35); }
.csp-ripple { border: 1.5px solid rgba(@light_rgb@, 0.9); }
.csp-ripple.csp-off { border-color: rgba(230, 221, 211, 0.45); }
.csp-caption { color: @pale@; }
.csp-caption.csp-off { color: rgba(230, 221, 211, 0.6); }

/* Hotspot tile */
.hsd-btn.hsd-danger:hover, .hsd-btn.hsd-danger:focus { background-color: rgba(@accent_rgb@, 0.55); }
.hsd-btn.hsd-accent { background-color: rgba(@accent_rgb@, 0.45); }
.hsd-btn.hsd-accent:hover, .hsd-btn.hsd-accent:focus { background-color: @accent@; }

/* Screenshot Card */
.ssc-btn.ssc-save { background-color: rgba(@accent_rgb@, 0.55); }
.ssc-btn.ssc-save:hover, .ssc-btn.ssc-save:focus { background-color: @accent@; }
.ssc-btn.ssc-delete:hover, .ssc-btn.ssc-delete:focus { background-color: rgba(@dark_rgb@, 0.7); }
.ssc-close { background-color: rgba(@bg_rgb@, 0.72); }
.ssc-close:hover, .ssc-close:focus { background-color: @accent@; }

/* Timers (top bar countdown) */
.finder-timer-icon { color: @light@; }
.finder-timer-label.finder-timer-soon { color: @light@; }
.finder-timer-btn:hover, .finder-timer-btn:focus { background-color: rgba(@accent_rgb@, 0.55); }

/* Pop-out */
.popout:hover { border-color: rgba(@light_rgb@, 0.75); }
.popout-btn:hover, .popout-btn:focus { background-color: rgba(@accent_rgb@, 0.75); }

/* Drag Switch countdown bar */
.drag-switch-bar {
  background-color: @accent@;
  box-shadow: 0 0 8px 1px rgba(@accent_rgb@, 0.6);
}
"""


# ---------- colour maths ----------
def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c))) for c in rgb)


def hsv_hex(h, s, v):
    return rgb_to_hex(c * 255 for c in colorsys.hsv_to_rgb(h % 1.0, max(0, min(1, s)), max(0, min(1, v))))


def dominant(path):
    """(hue, saturation, value) of the wallpaper's accent colour, or None for a grey one.
    Vivid colours win even when small (a red light on a dusky hill is the mood, not the
    dusk); only a wallpaper with no vivid parts falls back to its overall tone."""
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 160, 160, True)
    except GLib.Error:
        return None
    if pb.get_n_channels() < 3:
        return None
    data, stride, n = pb.get_pixels(), pb.get_rowstride(), pb.get_n_channels()
    vivid = [[0.0] * 5 for _ in range(36)]  # weight, sin, cos, s, v per 10-degree hue bin
    calm = [[0.0] * 5 for _ in range(36)]
    lit = 0
    for y in range(pb.get_height()):
        row = y * stride
        for x in range(pb.get_width()):
            i = row + x * n
            h, s, v = colorsys.rgb_to_hsv(data[i] / 255, data[i + 1] / 255, data[i + 2] / 255)
            if v < 0.12:
                continue  # near-black says nothing about the mood
            lit += 1
            if s < 0.08:
                continue
            bins, w = (vivid, s * v) if s >= 0.40 and v >= 0.15 else (calm, s * v)
            b = bins[int(h * 36) % 36]
            a = h * 2 * math.pi
            b[0] += w
            b[1] += w * math.sin(a)
            b[2] += w * math.cos(a)
            b[3] += w * s
            b[4] += w * v
    vivid_px = sum(b[0] for b in vivid) / 0.3  # roughly: how many vivid pixels
    bins = vivid if lit and vivid_px >= 0.004 * lit else calm
    if sum(b[0] for b in bins) < 1.0:
        return None  # black-and-white or very dull wallpaper
    # the strongest hue, smoothed with its neighbours
    best = max(range(36), key=lambda k: bins[k][0] + 0.5 * (bins[k - 1][0] + bins[(k + 1) % 36][0]))
    pick = [bins[(best + d) % 36] for d in (-1, 0, 1)]
    w = sum(b[0] for b in pick)
    hue = (math.atan2(sum(b[1] for b in pick), sum(b[2] for b in pick)) / (2 * math.pi)) % 1.0
    return hue, sum(b[3] for b in pick) / w, sum(b[4] for b in pick) / w


def palette(hsv):
    """The theme's shades, rebuilt in the wallpaper's hue."""
    if hsv is None:
        return dict(FIXED)
    h, s, _v = hsv
    s = max(0.30, min(0.64, s))  # muted wallpapers still get a visible accent; neon gets calmed
    k = s / 0.616                # saturation relative to the original #b1444d
    return {
        "accent": hsv_hex(h, s, 0.694),
        "light": hsv_hex(h, s * 0.873, 0.816),
        "dark": hsv_hex(h, s * 1.143, 0.557),
        "deep": hsv_hex(h, s * 1.20, 0.478),
        "pale": hsv_hex(h, s * 0.50, 0.906),
        "vivid": hsv_hex(h - 0.02, min(1, 0.82 * k + 0.05), 1.0),
        "vivid_deep": hsv_hex(h - 0.02, min(1, 0.91 * k), 0.86),
        "bg": hsv_hex(h, 0.143 * min(1, k), 0.055),
    }


# ---------- output ----------
def wallpaper_path():
    bg = Gio.Settings.new("org.gnome.desktop.background")
    dark = Gio.Settings.new("org.gnome.desktop.interface").get_string("color-scheme") == "prefer-dark"
    uri = bg.get_string("picture-uri-dark" if dark else "picture-uri") or bg.get_string("picture-uri")
    return Gio.File.new_for_uri(uri).get_path() if uri else None


def mode():
    try:
        with open(MODE_FILE) as f:
            return f.read().strip() or "auto"
    except OSError:
        return "auto"


def _write(name, text):
    path = os.path.join(OUT, name)
    try:
        with open(path) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)  # atomic, so the apps never read half a file
    return True


def apply():
    os.makedirs(OUT, exist_ok=True)
    src = wallpaper_path()
    pal = dict(FIXED) if mode() == "fixed" or not src else palette(dominant(src))
    rgb = {k: hex_to_rgb(v) for k, v in pal.items()}
    data = dict(pal, mode=mode(), wallpaper=src or "",
                rgb={k: [round(c / 255, 4) for c in v] for k, v in rgb.items()})
    _write("mood.json", json.dumps(data, indent=1) + "\n")
    gtk = ":root {\n" + "".join(f"  --mood-{k.replace('_', '-')}: {v};\n" for k, v in pal.items()) + "}\n"
    _write("gtk.css", "/* Wallpaper Mood: generated by ~/.local/bin/wallpaper-mood - do not edit. */\n" + gtk)
    css = SHELL_CSS
    for k, v in pal.items():
        css = css.replace(f"@{k}_rgb@", ", ".join(map(str, rgb[k]))).replace(f"@{k}@", v)
    _write("shell.css", css)
    src_ok = Gio.SettingsSchemaSource.get_default().lookup(DOCK, True)
    if src_ok:
        dock = Gio.Settings.new(DOCK)
        for key, val in (("custom-theme-running-dots-color", pal["accent"]), ("background-color", pal["bg"])):
            if dock.get_string(key).lower() != val:
                dock.set_string(key, val)
        Gio.Settings.sync()
    return pal


def watch():
    loop = GLib.MainLoop()
    state = {"mon": None, "timer": 0}

    def later(*_):
        if state["timer"]:
            GLib.source_remove(state["timer"])
        state["timer"] = GLib.timeout_add(700, run)

    def run():
        state["timer"] = 0
        try:
            apply()
        except Exception as e:  # a broken image must not kill the watcher
            print(f"wallpaper-mood: {e}", file=sys.stderr)
        arm()
        return GLib.SOURCE_REMOVE

    def arm():
        src = wallpaper_path()
        if state["mon"]:
            state["mon"].cancel()
            state["mon"] = None
        if src:  # the wallpaper file itself (it is often replaced in place)
            state["mon"] = Gio.File.new_for_path(src).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
            state["mon"].connect("changed", later)

    settings = [Gio.Settings.new("org.gnome.desktop.background"),
                Gio.Settings.new("org.gnome.desktop.interface")]
    settings[0].connect("changed::picture-uri", later)
    settings[0].connect("changed::picture-uri-dark", later)
    settings[1].connect("changed::color-scheme", later)
    mode_mon = Gio.File.new_for_path(MODE_FILE).monitor_file(Gio.FileMonitorFlags.NONE, None)
    mode_mon.connect("changed", later)
    run()
    loop.run()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd in ("fixed", "auto"):
        os.makedirs(OUT, exist_ok=True)
        _write("mode", cmd + "\n")
        cmd = ""
    if cmd == "--watch":
        watch()
        return 0
    if cmd and cmd != "show":
        print(__doc__)
        return 2
    pal = apply() if cmd != "show" else json.load(open(os.path.join(OUT, "mood.json")))
    print(f"mode {mode()}   " + "   ".join(f"{k} {pal[k]}" for k in FIXED))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
