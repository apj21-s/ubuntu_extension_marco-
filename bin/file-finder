MOOD_DIR = os.path.join(GLib.get_user_config_dir(), "ubuntu_extension_marco", "mood")


def watch_mood(display, on_change=None):
    """Wallpaper Mood: load its colour variables on top of ours and reload them live."""
    prov = Gtk.CssProvider()
    path = os.path.join(MOOD_DIR, "gtk.css")

    def load(*_):
        try:
            with open(path) as f:
                prov.load_from_string(f.read())
        except OSError:
            prov.load_from_string("")
        if on_change:
            on_change()

    load()
    Gtk.StyleContext.add_provider_for_display(display, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    os.makedirs(MOOD_DIR, exist_ok=True)
    mon = Gio.File.new_for_path(MOOD_DIR).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
    mon.connect("changed", lambda _m, f, o, _e: load() if "gtk.css" in (
        f.get_basename(), o.get_basename() if o else None) else None)
    return mon  # keep a reference, or the monitor stops



# ---------- ranking (no GTK: also used by the speed test) ----------
def score(path, words, phrase):
    """Higher is better. words are lower-case query words, phrase the whole query."""
    low = path.lower()
    name = low.rsplit("/", 1)[-1] or low
    stem = name.rsplit(".", 1)[0] if "." in name[1:] else name
    s = 0.0
    if all(w in name for w in words):
        s += 100
        if name == phrase or stem == phrase:
            s += 60
        if any(name.endswith("." + w) for w in words):
            s += 40  # "png", "cv pdf": the type of file asked for
        elif name.startswith(words[0]):
            s += 35
        elif any(name.startswith(w) or f" {w}" in name or f"-{w}" in name or f"_{w}" in name
                 or f".{w}" in name for w in words):
            s += 15
    if low.startswith(HOME.lower() + "/"):
        s += 60
        if any(d.lower() in low for d in USER_DIRS):
            s += 12
        rel = low[len(HOME) + 1:]
        if (rel.startswith(".") or "/." in rel) and not phrase.startswith("."):
            s -= 30  # hidden config/data folders
    elif low.startswith(DRIVE_ROOTS):
        s += 45  # USB drives: the user's own files too
    for n in NOISE:
        if n.lower() in low and not any(w in n.lower() for w in words):
            s -= 60
            break
    s -= low.count("/") * 2.0
    s -= len(name) * 0.15
    return s


def rank(paths, query):
    words = [w for w in query.lower().split() if w]
    if not words:
        return []
    phrase = " ".join(words)
    seen = set()
    uniq = [p for p in paths if p and not (p in seen or seen.add(p))]
    return sorted(uniq, key=lambda p: -score(p, words, phrase))


def _visible_home_dirs():
    """~/Documents, ~/Downloads, ... (not hidden folders like ~/.cache)."""
    try:
        return sorted(e.path for e in os.scandir(HOME)
                      if not e.name.startswith(".") and e.is_dir(follow_symlinks=False))[:16]
    except OSError:
        return []


def _db_arg(dbs):
    return ":".join(d.replace("\\", "\\\\").replace(":", "\\:") for d in dbs)


def plocate_cmds(query, extra_dbs=()):
    """The searches run (at the same time) for one query. All use plocate's fast
    substring index; a search per visible home folder keeps hidden folders like
    ~/.cache from filling the limit before ~/Documents is reached. extra_dbs are
    the USB drive indexes, searched together with the system one."""
    words = query.split()
    short = len(query.strip()) <= 2  # "x", "py": almost everything matches, fewer is plenty
    name_n, path_n, dir_n = (NAME_LIMIT // 3, PATH_LIMIT // 3, 150) if short else (NAME_LIMIT, PATH_LIMIT, 400)
    base = ["plocate", "-i"]
    if extra_dbs:
        base += ["-d", _db_arg([DB, *extra_dbs])]
    cmds = [
        [*base, "-b", "-l", str(name_n), "--", *words],        # name matches
        [*base, "-l", str(path_n), "--", *words, HOME + "/"],  # anywhere in home
        [*base, "-l", str(path_n), "--", *words],              # anywhere at all
    ]
    for d in _visible_home_dirs() if len(query.strip()) > 1 else []:
        cmds.append(["plocate", "-i", "-l", str(dir_n), "--", *words, d + "/"])
    return cmds


# ---------- live watch (inotify) ----------
IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO, IN_CREATE, IN_DELETE = 0x8, 0x40, 0x80, 0x100, 0x200
IN_Q_OVERFLOW, IN_IGNORED, IN_ONLYDIR, IN_DONT_FOLLOW = 0x4000, 0x8000, 0x1000000, 0x2000000
IN_ISDIR, IN_NONBLOCK, IN_CLOEXEC = 0x40000000, 0o4000, 0o2000000
WATCH_MASK = IN_CREATE | IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO | IN_CLOSE_WRITE | IN_ONLYDIR | IN_DONT_FOLLOW
EVENT = struct.Struct("iIII")


class LiveIndex:
    """Files created, moved in or deleted since the last index refresh, seen live through
    inotify on the home folder and plugged-in drives."""

    def __init__(self):
        self.added = {}    # path -> time it appeared
        self.listeners = []  # called with (path, gone) for every change (the content index)
        self.wd = {}       # watch descriptor -> folder
        self.by_path = {}  # folder -> watch descriptor
        self.fd = -1
        self._queue = []   # folder trees still to walk
        self._walking = False
        try:
            self._libc = ctypes.CDLL(None, use_errno=True)
            self._libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
            self._libc.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
            self.fd = self._libc.inotify_init1(IN_NONBLOCK | IN_CLOEXEC)
        except (OSError, AttributeError):
            self.fd = -1
        if self.fd >= 0:
            ch = GLib.IOChannel.unix_new(self.fd)
            GLib.io_add_watch(ch, GLib.PRIORITY_DEFAULT_IDLE, GLib.IOCondition.IN, self._on_events)

    # walking happens in small idle steps so the window never stutters
    def add_tree(self, root, record=False):
        if self.fd < 0:
            return
        self._queue.append((root, record))
        if not self._walking:
            self._walking = True
            GLib.idle_add(self._walk_step, self._walk())

    def _walk(self):
        while self._queue:
            root, record = self._queue.pop(0)
            for top, dirs, files in os.walk(root):
                dirs[:] = [d for d in dirs if d not in NO_WATCH and not d.startswith(".")
                           and not os.path.islink(os.path.join(top, d))]
                if not self._watch(top):
                    dirs[:] = []
                if record:
                    now = time.time()
                    for n in files + dirs:
                        self.added[os.path.join(top, n)] = now
                yield

    def _walk_step(self, gen):
        for _ in range(200):
            if next(gen, StopIteration) is StopIteration:
                self._walking = False
                return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    def _watch(self, folder):
        if folder in self.by_path:
            return True
        if len(self.wd) >= MAX_WATCHES:
            return False
        wd = self._libc.inotify_add_watch(self.fd, os.fsencode(folder), WATCH_MASK)
        if wd < 0:
            return False
        self.wd[wd] = folder
        self.by_path[folder] = wd
        return True

    def remove_tree(self, root):
        pre = root.rstrip("/") + "/"
        for folder in [f for f in self.by_path if f == root or f.startswith(pre)]:
            wd = self.by_path.pop(folder)
            self.wd.pop(wd, None)
            if self.fd >= 0:
                self._libc.inotify_rm_watch(self.fd, wd)
        for p in [p for p in self.added if p.startswith(pre)]:
            del self.added[p]

    def _on_events(self, _ch, _cond):
        try:
            data = os.read(self.fd, 256 * 1024)
        except BlockingIOError:
            return True
        except OSError:
            return False
        i = 0
        while i + EVENT.size <= len(data):
            wd, mask, _cookie, size = EVENT.unpack_from(data, i)
            name = data[i + EVENT.size:i + EVENT.size + size].rstrip(b"\0")
            i += EVENT.size + size
            if mask & IN_IGNORED:
                folder = self.wd.pop(wd, None)
                if folder:
                    self.by_path.pop(folder, None)
                continue
            if mask & IN_Q_OVERFLOW or wd not in self.wd or not name:
                continue
            path = os.path.join(self.wd[wd], os.fsdecode(name))
            for listener in self.listeners:
                if mask & (IN_CLOSE_WRITE | IN_MOVED_TO | IN_DELETE | IN_MOVED_FROM) or mask & IN_ISDIR:
                    listener(path, bool(mask & (IN_DELETE | IN_MOVED_FROM)))
            if mask & IN_CLOSE_WRITE:
                continue
            if mask & (IN_CREATE | IN_MOVED_TO):
                self.added[path] = time.time()
                base = os.path.basename(path)
                if mask & IN_ISDIR and base not in NO_WATCH and not base.startswith("."):
                    self.add_tree(path, record=True)  # catch files made before the watch started
            elif mask & (IN_DELETE | IN_MOVED_FROM):
                self.added.pop(path, None)
                if mask & IN_ISDIR:
                    self.remove_tree(path)
        return True

    def match(self, words):
        return [p for p in self.added if all(w in p.lower() for w in words)]

    def prune(self, index_time):
        """Forget what an index refresh has picked up since. index_time(path) -> mtime."""
        for p, t in list(self.added.items()):
            if t < index_time(p) - 5:
                del self.added[p]


# ---------- USB drives ----------
class Drives:
    """One plocate index per plugged-in drive, kept in ~/.cache/file-finder/drives/."""

    def __init__(self, live, on_change):
        self.live = live
        self.on_change = on_change
        self.mounted = {}  # mount folder -> its index file
        self.monitor = Gio.VolumeMonitor.get()
        self.monitor.connect("mount-added", lambda _m, mount: self._added(mount))
        self.monitor.connect("mount-removed", lambda _m, mount: self._removed(mount))
        for mount in self.monitor.get_mounts():
            self._added(mount)
        GLib.timeout_add_seconds(DRIVE_REFRESH_S, self._refresh_all)

    @staticmethod
    def _root(mount):
        root = mount.get_root().get_path()
        return root if root and root.startswith(DRIVE_ROOTS) else None

    def _added(self, mount):
        root = self._root(mount)
        if not root or root in self.mounted:
            return
        vol = mount.get_volume()
        key = mount.get_uuid() or (vol.get_uuid() if vol else None) or root.strip("/").replace("/", "_")
        self.mounted[root] = os.path.join(DRIVE_DBS, key + ".db")
        self.live.add_tree(root)
        self._index(root)

    def _removed(self, mount):
        root = self._root(mount)
        if root and self.mounted.pop(root, None):
            self.live.remove_tree(root)
            self.on_change()

    def _index(self, root):
        db = self.mounted.get(root)
        if not db:
            return
        os.makedirs(DRIVE_DBS, exist_ok=True)
        argv = ["nice", "-n", "19", "ionice", "-c", "3", "updatedb", "-l", "no", "-U", root,
                "-o", db, "--prunepaths", "", "--prunefs", "", "--prunenames", ""]
        try:
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            return
        proc.wait_async(None, lambda *_: self.on_change())

    def _refresh_all(self):
        for root in list(self.mounted):
            self._index(root)
        return GLib.SOURCE_CONTINUE

    def dbs(self):
        return [db for db in self.mounted.values() if os.path.exists(db)]

    def index_time(self, path):
        """mtime of the index that covers path (0 = none yet)."""
        for root, db in self.mounted.items():
            if path.startswith(root.rstrip("/") + "/"):
                try:
                    return os.stat(db).st_mtime
                except OSError:
                    return 0
        try:
            return os.stat(DB).st_mtime
        except OSError:
            return 0


# ---------- protected files (root helper) ----------
class RootHelper:
    """Runs /usr/local/sbin/file-finder-root through pkexec (one password popup) and
    sends it searches over a pipe, one JSON line each way."""

    def __init__(self, on_state):
        self.on_state = on_state  # called with "starting", "ready" or "off"
        self.proc = None
        self.ready = False
        self._next = 0
        self._waiting = {}

    def start(self):
        if self.proc:
            return
        if not os.path.exists(ROOT_HELPER):
            self.on_state("missing")
            return
        try:
            self.proc = Gio.Subprocess.new(["pkexec", ROOT_HELPER],
                                           Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE
                                           | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self.on_state("off")
            return
        self._out = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self._in = self.proc.get_stdin_pipe()
        self.proc.wait_async(None, self._on_exit, self.proc)
        self._read()
        self.on_state("starting")

    def stop(self):
        if self.proc:
            try:
                self._in.close(None)  # the helper quits when its input closes
            except GLib.Error:
                self.proc.force_exit()

    def _on_exit(self, _p, _res, proc):
        if proc is not self.proc:
            return
        self.proc, self.ready = None, False
        for cb in self._waiting.values():
            cb([])
        self._waiting.clear()
        self.on_state("off")

    def _read(self):
        if self.proc:
            self._out.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line, self.proc)

    def _on_line(self, stream, res, proc):
        try:
            line, _len = stream.read_line_finish_utf8(res)
        except GLib.Error:
            return
        if line is None or proc is not self.proc:
            return
        try:
            msg = json.loads(line)
        except ValueError:
            msg = {}
        if msg.get("ready") and not self.ready:
            self.ready = True
            self.on_state("ready")
        cb = self._waiting.pop(msg.get("id"), None)
        if cb:
            cb(msg.get("paths") or [])
        self._read()

    def query(self, words, limit, basename, cb):
        if not (self.proc and self.ready):
            cb([])
            return
        self._next += 1
        self._waiting[self._next] = cb
        req = json.dumps({"id": self._next, "words": words, "limit": limit, "basename": basename}) + "\n"
        try:
            self._in.write_all(req.encode(), None)
        except GLib.Error:
            self._waiting.pop(self._next, None)
            cb([])


def _value(gtype, obj):
    v = GObject.Value()
    v.init(gtype)
    v.set_boxed(obj)
    return v


def _short(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


def _when(ts):
    if not ts:
        return ""
    t, now = time.localtime(ts), time.localtime()
    if t.tm_year == now.tm_year and t.tm_yday == now.tm_yday:
        return time.strftime("%H:%M", t)
    if t.tm_year == now.tm_year:
        return time.strftime("%b %-d", t)
    return time.strftime("%b %Y", t)


def _ago(ts):
    m = int((time.time() - ts) // 60)
    if m < 1:
        return "just now"
    if m < 60:
        return f"{m} min ago"
    if m < 48 * 60:
        return f"{m // 60} h ago"
    return f"{m // 1440} days ago"


MARK = "#d0606a"  # matched letters; follows Wallpaper Mood's light accent


def _mood_changed():
    global MARK
    try:
        with open(os.path.join(MOOD_DIR, "mood.json")) as f:
            MARK = json.load(f).get("light") or MARK
    except (OSError, ValueError):
        pass


def _markup(name, words):
    """File name with the matched parts in crimson bold."""
    low = name.lower()
    hit = [False] * len(name)
    for w in words:
        i = low.find(w)
        while w and i != -1:
            for k in range(i, i + len(w)):
                hit[k] = True
            i = low.find(w, i + len(w))
    out, i = [], 0
    while i < len(name):
        j = i
        while j < len(name) and hit[j] == hit[i]:
            j += 1
        part = GLib.markup_escape_text(name[i:j])
        out.append(f'<span foreground="{MARK}" weight="bold">{part}</span>' if hit[i] else part)
        i = j
    return "".join(out)


def _gfile(path, protected):
    """Protected files open through admin:// (Files and most apps ask for the password)."""
    if protected:
        return Gio.File.new_for_uri("admin://" + urllib.parse.quote(path))
    return Gio.File.new_for_path(path)


# ---------- contents: full-text index of Documents and Downloads ----------
CONTENT_DB = os.path.join(GLib.get_user_cache_dir(), "file-finder", "content.db")
CONTENT_ROOTS = [os.path.join(HOME, "Documents"), os.path.join(HOME, "Downloads")]
CONTENT_SKIP = NO_WATCH | {".next", "dist", "build", "target", ".idea", ".gradle", "coverage"}
MAX_TEXT_BYTES = 2_000_000   # bigger plain-text files are logs/data dumps
MAX_BODY = 400_000           # characters kept per file
OFFICE = {".docx": ("word/document.xml",), ".pptx": ("ppt/slides/slide",), ".xlsx": ("xl/sharedStrings.xml",),
          ".odt": ("content.xml",), ".ods": ("content.xml",), ".odp": ("content.xml",)}
NOT_TEXT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".ico", ".bmp", ".tif", ".tiff", ".heic",
            ".mp4", ".mkv", ".mov", ".avi", ".webm", ".mp3", ".wav", ".flac", ".ogg", ".m4a", ".zip",
            ".tar", ".gz", ".xz", ".bz2", ".7z", ".rar", ".deb", ".rpm", ".apk", ".iso", ".exe", ".dll",
            ".so", ".o", ".a", ".class", ".jar", ".pyc", ".mo", ".bin", ".db", ".sqlite", ".woff",
            ".woff2", ".ttf", ".otf", ".psd", ".blend", ".map", ".lock", ".dmg", ".img", ".pkl", ".pt",
            ".npy", ".npz", ".h5", ".onnx", ".doc", ".ppt", ".xls"}


def extract_text(path, size):
    """Searchable text of a file, or None if it has none."""
    low = path.lower()
    ext = os.path.splitext(low)[1]
    if ext in NOT_TEXT or low.endswith((".min.js", ".min.css")):
        return None
    try:
        if ext == ".pdf":
            out = subprocess.run(["nice", "-n", "19", "pdftotext", "-q", "-l", "80", "-enc", "UTF-8", path, "-"],
                                 capture_output=True, timeout=40).stdout
            return out.decode("utf-8", "replace")[:MAX_BODY]
        if ext in OFFICE:
            parts = []
            with zipfile.ZipFile(path) as z:
                for n in sorted(z.namelist()):
                    if any(n == p or (n.startswith(p) and n.endswith(".xml")) for p in OFFICE[ext]):
                        xml = z.read(n).decode("utf-8", "replace")
                        parts.append(html.unescape(re.sub(r"<[^>]+>", " ", re.sub(r"</(w:p|a:p|text:p)>", "\n", xml))))
            return re.sub(r"[ \t]+", " ", "\n".join(parts))[:MAX_BODY]
        if size > MAX_TEXT_BYTES:
            return None
        with open(path, "rb") as f:
            data = f.read()
        if b"\0" in data[:8192]:
            return None  # binary
        text = data.decode("utf-8", "replace")
        if ext == ".ipynb":
            try:
                text = "\n".join("".join(c.get("source", "")) for c in json.loads(text).get("cells", []))
            except (ValueError, AttributeError):
                pass
        return text[:MAX_BODY]
    except (OSError, subprocess.SubprocessError, zipfile.BadZipFile, KeyError, RuntimeError):
        return None


class ContentIndex:
    """SQLite full-text index of the files in Documents and Downloads. A background thread
    (at the lowest priority) indexes them; the live watch tells it what changed."""

    def __init__(self, on_progress):
        self.on_progress = on_progress
        self.q = queue.Queue()
        self.busy = 0
        os.makedirs(os.path.dirname(CONTENT_DB), exist_ok=True)
        self.db = self._connect()
        threading.Thread(target=self._worker, name="content-index", daemon=True).start()
        self.q.put(("scan", None))

    @staticmethod
    def _connect():
        conn = sqlite3.connect(CONTENT_DB, timeout=10, check_same_thread=False)
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("CREATE TABLE IF NOT EXISTS files(path TEXT PRIMARY KEY, mtime REAL, size INTEGER, rid INTEGER)")
        conn.execute("CREATE VIRTUAL TABLE IF NOT EXISTS docs USING fts5(name, body, "
                     "tokenize='unicode61 remove_diacritics 2')")
        return conn

    @staticmethod
    def covers(path):
        return any(path == r or path.startswith(r + "/") for r in CONTENT_ROOTS)

    def changed(self, path, gone):
        if self.covers(path) and "/." not in path[len(HOME):]:
            self.q.put(("del" if gone else "add", path))

    def count(self):
        try:
            return self.db.execute("SELECT count(*) FROM files WHERE rid IS NOT NULL").fetchone()[0]
        except sqlite3.Error:
            return 0

    def search(self, query, limit=SHOW):
        words = re.findall(r"\w+", query.lower())
        if not words:
            return []
        # the exact phrase first ("def main"), then files that have all the words anywhere
        tries = (['"%s"*' % " ".join(words)] if len(words) > 1 else []) + [" AND ".join('"%s"*' % w for w in words)]
        out, seen = [], set()
        for match in tries:
            try:
                rows = self.db.execute(
                    "SELECT f.path, snippet(docs, 1, char(2), char(3), ' … ', 16) FROM docs "
                    "JOIN files f ON f.rid = docs.rowid WHERE docs MATCH ? "
                    "ORDER BY bm25(docs, 6.0, 1.0) LIMIT ?", (match, limit)).fetchall()
            except sqlite3.Error:
                continue
            for p, snip in rows:
                if p not in seen and os.path.exists(p):
                    seen.add(p)
                    out.append((p, snip))
            if len(out) >= limit:
                break
        return out[:limit]

    # ----- background thread -----
    def _worker(self):
        try:
            os.setpriority(os.PRIO_PROCESS, threading.get_native_id(), 19)
        except (OSError, AttributeError):
            pass
        conn = self._connect()
        n = 0
        while True:
            op, path = self.q.get()
            self.busy = self.q.qsize() + 1
            try:
                if op == "scan":
                    self._scan(conn)
                elif op == "del":
                    self._delete(conn, path)
                elif os.path.isdir(path):
                    for p in self._walk(path):
                        self._index(conn, p)
                else:
                    self._index(conn, path)
            except Exception as e:  # one bad file must never stop the indexer
                print(f"file-finder: content index: {e}", file=sys.stderr)
            n += 1
            if self.q.empty() or n % 40 == 0:
                conn.commit()
                self.busy = self.q.qsize()
                GLib.idle_add(self.on_progress)

    def _walk(self, top):
        for root, dirs, files in os.walk(top):
            dirs[:] = [d for d in dirs if d not in CONTENT_SKIP and not d.startswith(".")]
            for f in files:
                if not f.startswith("."):
                    yield os.path.join(root, f)

    def _scan(self, conn):
        known = {p: (m, s) for p, m, s in conn.execute("SELECT path, mtime, size FROM files")}
        seen = set()
        for root in CONTENT_ROOTS:
            for p in self._walk(root):
                seen.add(p)
                try:
                    st = os.stat(p)
                except OSError:
                    continue
                if known.get(p) != (st.st_mtime, st.st_size):
                    self.q.put(("add", p))
        for p in set(known) - seen:
            self.q.put(("del", p))

    def _delete(self, conn, path):
        rows = conn.execute("SELECT path, rid FROM files WHERE path = ? OR path LIKE ? ESCAPE '\\'",
                            (path, path.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "/%")).fetchall()
        for p, rid in rows:
            if rid is not None:
                conn.execute("DELETE FROM docs WHERE rowid = ?", (rid,))
            conn.execute("DELETE FROM files WHERE path = ?", (p,))

    def _index(self, conn, path):
        try:
            st = os.stat(path)
        except OSError:
            self._delete(conn, path)
            return
        if not os.path.isfile(path):
            return
        row = conn.execute("SELECT mtime, size, rid FROM files WHERE path = ?", (path,)).fetchone()
        if row and (row[0], row[1]) == (st.st_mtime, st.st_size):
            return
        text = extract_text(path, st.st_size)
        rid = row[2] if row else None
        if text is None or not text.strip():
            if rid is not None:
                conn.execute("DELETE FROM docs WHERE rowid = ?", (rid,))
            rid = None  # remembered as "nothing to index" so it isn't read again
        elif rid is not None:
            conn.execute("UPDATE docs SET name = ?, body = ? WHERE rowid = ?", (os.path.basename(path), text, rid))
        else:
            rid = conn.execute("INSERT INTO docs(name, body) VALUES (?, ?)", (os.path.basename(path), text)).lastrowid
        conn.execute("INSERT OR REPLACE INTO files(path, mtime, size, rid) VALUES (?, ?, ?, ?)",
                     (path, st.st_mtime, st.st_size, rid))


def snippet_markup(s):
    s = " ".join(s.split())
    parts = re.split("(\x02|\x03)", s)
    out, on = [], False
    for part in parts:
        if part == "\x02":
            on = True
        elif part == "\x03":
            on = False
        elif part:
            esc = GLib.markup_escape_text(part)
            out.append(f'<span foreground="{MARK}" weight="bold">{esc}</span>' if on else esc)
    return "".join(out)


# ---------- apps ----------
class Apps:
    def __init__(self):
        self.apps = []
        self._mon = Gio.AppInfoMonitor.get()
        self._mon.connect("changed", lambda *_: self._load())
        self._load()

    def _load(self):
        self.apps = []
        for a in Gio.AppInfo.get_all():
            if not a.should_show():
                continue
            kw = a.get_keywords() if hasattr(a, "get_keywords") else []
            gen = a.get_generic_name() if hasattr(a, "get_generic_name") else ""
            hay = " ".join([a.get_display_name() or "", gen or "", " ".join(kw or []),
                            os.path.basename(a.get_executable() or "")]).lower()
            self.apps.append((a, hay, (a.get_display_name() or "").lower()))

    def match(self, words, limit=4):
        hits = []
        for a, hay, name in self.apps:
            if all(w in hay for w in words):
                s = (3 if name.startswith(words[0]) else 2 if all(w in name for w in words) else 1)
                hits.append((-s, len(name), a))
        hits.sort(key=lambda h: h[:2])
        return [a for _s, _n, a in hits[:limit]]


# ---------- commands (type ">") ----------
PROTECTED_PROCS = {"gnome-shell", "gnome-session-binary", "gnome-session", "systemd", "dbus-daemon",
                   "dbus-broker", "pipewire", "pipewire-pulse", "wireplumber", "Xwayland", "gvfsd",
                   "xdg-desktop-portal", "xdg-document-portal", "xdg-permission-store", "at-spi-bus-launcher",
                   "at-spi2-registryd", "gnome-keyring-daemon", "ibus-daemon", "mutter-x11-frames",
                   "bash", "sh", "fish", "zsh", "sshd", "login", "sudo", "polkitd"}
CALC_OK = re.compile(r"^[\d\s.+\-*/%()^,a-z]*$", re.I)
CALC_NAMES = {k: getattr(math, k) for k in ("sqrt", "sin", "cos", "tan", "asin", "acos", "atan", "log10",
                                             "log2", "exp", "floor", "ceil", "pi", "e", "tau", "factorial")}
CALC_NAMES["factorial"] = lambda x: math.factorial(int(x)) if 0 <= x <= 170 else math.inf
CALC_NAMES.update(log=math.log, ln=math.log, abs=abs, round=round, min=min, max=max)


def calc(expr):
    """Safe calculator: numbers, + - * / // % ** ^ ( ) and a few math functions."""
    expr = expr.strip().replace("^", "**").replace("×", "*").replace("÷", "/")
    if not expr or not CALC_OK.match(expr):
        return None
    try:
        tree = ast.parse(expr.replace(",", ""), mode="eval")
    except SyntaxError:
        return None
    ops = {ast.Add: lambda a, b: a + b, ast.Sub: lambda a, b: a - b, ast.Mult: lambda a, b: a * b,
           ast.Div: lambda a, b: a / b, ast.FloorDiv: lambda a, b: a // b, ast.Mod: lambda a, b: a % b,
           ast.Pow: lambda a, b: a ** b if abs(b) <= 1000 else math.inf}

    def ev(n):
        if isinstance(n, ast.Expression):
            return ev(n.body)
        if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)):
            return n.value
        if isinstance(n, ast.BinOp) and type(n.op) in ops:
            return ops[type(n.op)](ev(n.left), ev(n.right))
        if isinstance(n, ast.UnaryOp) and isinstance(n.op, (ast.USub, ast.UAdd)):
            return -ev(n.operand) if isinstance(n.op, ast.USub) else ev(n.operand)
        if isinstance(n, ast.Name) and n.id in CALC_NAMES and not callable(CALC_NAMES[n.id]):
            return CALC_NAMES[n.id]
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and callable(CALC_NAMES.get(n.func.id)):
            return CALC_NAMES[n.func.id](*[ev(a) for a in n.args])
        raise ValueError("not allowed")

    try:
        v = ev(tree)
    except (ValueError, ArithmeticError, TypeError, OverflowError):
        return None
    if isinstance(v, float):
        if v != v or v in (math.inf, -math.inf):
            return None
        if v.is_integer() and abs(v) < 1e15:
            v = int(v)
        else:
            return f"{v:.10g}"
    return f"{v:,}".replace(",", " ") if isinstance(v, int) and abs(v) >= 10000 else str(v)


def parse_duration(text):
    """'25' -> 25 min, '90s', '1h', '1h30', '2:30' (min:sec). Returns (seconds, label) or None."""
    m2 = re.match(r"^\s*(\d+):(\d{1,2})\s*(.*)$", text)
    if m2:
        secs = int(m2.group(1)) * 60 + int(m2.group(2))
        return (secs, m2.group(3).strip()) if 0 < secs <= 24 * 3600 else None
    m = re.match(r"^\s*(\d+(?:\.\d+)?)\s*(h|hr|hours?|m|min|mins|minutes?|s|sec|secs|seconds?)?"
                 r"(?:\s*(\d+)\s*(m|min|s)?)?\s*(.*)$", text, re.I)
    if not m:
        return None
    n, unit, n2, unit2, label = m.groups()
    n = float(n)
    unit = (unit or "m")[0].lower()
    secs = n * {"h": 3600, "m": 60, "s": 1}[unit]
    if n2:
        secs += int(n2) * (1 if (unit2 or "").startswith("s") or unit == "m" else 60)
    return (int(secs), label.strip()) if 0 < secs <= 24 * 3600 else None


def _fmt_secs(s):
    s = max(0, int(s))
    h, r = divmod(s, 3600)
    m, sec = divmod(r, 60)
    return f"{h}:{m:02d}:{sec:02d}" if h else f"{m}:{sec:02d}"


def _run(*argv):
    try:
        Gio.Subprocess.new(list(argv), Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        return True
    except GLib.Error:
        return False


def _notify(title, body="", icon="alarm-symbolic"):
    tool = os.path.join(HOME, ".local", "bin", "notify")
    if os.access(tool, os.X_OK):
        _run(tool, "-i", icon, title, body)
    else:
        _run("notify-send", "-i", icon, title, body)


def user_processes(name):
    """{process name: [pids]} for this user's processes whose name contains name."""
    me, mine = os.getuid(), os.getpid()
    groups = {}
    name = name.lower()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == mine:
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != me:
                continue
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip()
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                exe = os.path.basename(f.read().split(b"\0", 1)[0].decode("utf-8", "replace"))
        except OSError:
            continue
        key = exe if exe and name in exe.lower() else comm
        if name in key.lower() and key not in PROTECTED_PROCS and comm not in PROTECTED_PROCS:
            groups.setdefault(key, []).append(int(pid))
    return groups


