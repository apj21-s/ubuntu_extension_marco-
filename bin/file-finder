class Finder(Gtk.ApplicationWindow):
    """One box: files (default), apps, "> commands", and Tab for searching inside files."""

    PLACEHOLDER = {"files": "Search files, apps and commands",
                   "contents": "Search inside documents, PDFs and code"}

    def __init__(self, app):
        super().__init__(application=app, title="File Finder")
        self.set_decorated(False)
        self.set_default_size(1200, 800)
        self.maximize()
        self.add_css_class("finder")
        self.set_hide_on_close(True)

        self._gen = 0
        self._procs = []
        self._dragging = False
        self._auth = False  # password popup open: don't hide when focus goes to it
        self._was_active = False
        self._protected = set()  # results only the root helper could see
        self.mode = "files"
        self.timers = []

        self.live = LiveIndex()
        self.drives = Drives(self.live, self._index_changed)
        self.root = RootHelper(self._root_state)
        self.apps = Apps()
        self.contents = ContentIndex(self._content_progress)
        self.live.listeners.append(self.contents.changed)
        self.live.add_tree(HOME)

        # full-screen see-through backdrop with the panel floating a bit above the middle
        backdrop = Gtk.Box()
        backdrop.add_css_class("backdrop")
        self.set_child(backdrop)
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.CENTER,
                        valign=Gtk.Align.CENTER, hexpand=True, vexpand=True, width_request=720)
        panel.set_margin_bottom(120)
        panel.add_css_class("panel")
        backdrop.append(panel)
        self.panel = panel
        click = Gtk.GestureClick(button=0)
        click.connect("pressed", self._on_backdrop_click)
        backdrop.add_controller(click)

        top = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER)
        top.add_css_class("searchrow")
        self.entry = Gtk.SearchEntry(placeholder_text="Search files, apps and commands", hexpand=True)
        self.entry.add_css_class("search")
        self.entry.set_search_delay(60)
        self.entry.connect("search-changed", lambda *_: self.search())
        seg = Gtk.Box(valign=Gtk.Align.CENTER)
        seg.add_css_class("segmented")
        self.seg_files = Gtk.ToggleButton(label="Files", focus_on_click=False, active=True,
                                          tooltip_text="File names, apps and commands")
        self.seg_contents = Gtk.ToggleButton(label="Contents", focus_on_click=False, group=self.seg_files,
                                             tooltip_text="Inside PDFs, documents and code (Tab)")
        self.seg_files.connect("toggled", lambda b: b.get_active() and self.mode != "files" and self.set_mode("files"))
        self.seg_contents.connect("toggled",
                                  lambda b: b.get_active() and self.mode != "contents" and self.set_mode("contents"))
        seg.append(self.seg_files)
        seg.append(self.seg_contents)
        top.append(self.entry)
        top.append(seg)
        panel.append(top)
        div = Gtk.Box()
        div.add_css_class("divider")
        panel.append(div)

        self.section = Gtk.Label(xalign=0)
        self.section.add_css_class("section")
        panel.append(self.section)

        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False)
        self.list.connect("row-activated", lambda _l, row: self.activate(row.item))
        self.empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, valign=Gtk.Align.CENTER, vexpand=True)
        self.empty_icon = Gtk.Image(icon_name="system-search-symbolic", pixel_size=40)
        self.empty_icon.add_css_class("empty-icon")
        self.hint = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.hint.add_css_class("empty")
        self.empty.append(self.empty_icon)
        self.empty.append(self.hint)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=90)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        scroll.set_child(self.list)
        self.scroll = scroll
        self.stack.add_named(scroll, "list")
        self.stack.add_named(self.empty, "empty")
        self.stack.set_size_request(-1, 380)
        panel.append(self.stack)

        footer = Gtk.Box(spacing=14)
        footer.add_css_class("footer")
        self.foot = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        self.foot.add_css_class("status")
        self.keys = Gtk.Box(spacing=12, valign=Gtk.Align.CENTER)
        self.lock = Gtk.ToggleButton(icon_name="changes-prevent-symbolic", focus_on_click=False,
                                     valign=Gtk.Align.CENTER,
                                     tooltip_text="Also search protected files: other users, /root, "
                                                  "system data (asks for your password)   Ctrl+Shift+A")
        self.lock.add_css_class("lock")
        self._lock_handler = self.lock.connect("toggled", lambda b: self.set_protected(b.get_active()))
        footer.append(self.foot)
        footer.append(self.keys)
        footer.append(self.lock)
        panel.append(footer)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._on_key)
        self.add_controller(keys)
        self.connect("notify::is-active", self._on_active)
        self.connect("hide", lambda *_: GLib.timeout_add_seconds(2, self._trim))

        self.reset()

    def _trim(self):
        """Hidden: drop the result rows and hand freed memory back to the system."""
        if not self.get_visible():
            self.list.remove_all()
            try:
                ctypes.CDLL(None).malloc_trim(0)
            except (OSError, AttributeError):
                pass
        return GLib.SOURCE_REMOVE

    # ---------- show / hide ----------
    def reset(self):
        self._gen += 1
        self._stop_procs()
        self.set_mode("files", search=False)
        self.entry.set_text("")
        self.search()

    def toggle(self):
        if self.get_visible() and self.is_active():
            self.set_visible(False)
            return
        self.reset()
        self.set_opacity(1)
        self.present()
        self.entry.grab_focus()

    def _on_active(self, *_):
        active = self.is_active()
        if self._was_active and not active and self.get_visible() and not (self._dragging or self._auth):
            self.set_visible(False)
        self._was_active = active

    def set_mode(self, mode, search=True):
        self.mode = mode
        self.entry.set_placeholder_text(self.PLACEHOLDER[mode])
        (self.seg_contents if mode == "contents" else self.seg_files).set_active(True)
        if search:
            self.search()

    # ---------- protected mode ----------
    def set_protected(self, on):
        if on:
            self._auth = True
            self.root.start()
        else:
            self.root.stop()

    def _root_state(self, state):
        self.lock.handler_block(self._lock_handler)
        self.lock.set_active(state in ("starting", "ready"))
        self.lock.handler_unblock(self._lock_handler)
        self.lock.set_icon_name("changes-allow-symbolic" if state == "ready" else "changes-prevent-symbolic")
        if state == "ready":
            self._auth = False
            self.present()
            self.entry.grab_focus()
            self.search()
        elif state in ("off", "missing"):
            was_auth = self._auth
            self._auth = False
            self._protected.clear()
            self.say("Protected search needs the system part of the installer" if state == "missing"
                     else "Protected files: password not given" if was_auth else "Protected files: off", warn=True)
            if self.get_visible() and self.entry.get_text().strip():
                GLib.timeout_add(1200, lambda: self.search() and False)

    # ---------- search ----------
    def _stop_procs(self):
        for p in self._procs:
            p.force_exit()
        self._procs = []

    def _index_changed(self):
        self.live.prune(self.drives.index_time)
        if self.get_visible() and self.mode == "files" and not self.entry.get_text().startswith(">"):
            self.search()

    def _content_progress(self):
        if self.get_visible() and self.mode == "contents" and not self.entry.get_text().strip():
            self.search()
        return GLib.SOURCE_REMOVE

    def _on_backdrop_click(self, gesture, _n, x, y):
        """A click anywhere outside the panel closes the finder."""
        target = self.get_child().pick(x, y, Gtk.PickFlags.DEFAULT)
        if target is None or not (target is self.panel or target.is_ancestor(self.panel)):
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            self.set_visible(False)

    def set_keys(self, pairs):
        """Footer hints: [(key, what it does), ...]."""
        while (c := self.keys.get_first_child()):
            self.keys.remove(c)
        for key, text in pairs:
            box = Gtk.Box(spacing=5)
            cap = Gtk.Label(label=key)
            cap.add_css_class("keycap")
            lbl = Gtk.Label(label=text)
            lbl.add_css_class("keytext")
            box.append(cap)
            box.append(lbl)
            self.keys.append(box)

    def show_empty(self, text, icon="system-search-symbolic"):
        self.hint.set_label(text)
        self.empty_icon.set_from_icon_name(icon)
        self.stack.set_visible_child_name("empty")

    def say(self, text, warn=False):
        (self.foot.add_css_class if warn else self.foot.remove_css_class)("warn")
        self.foot.set_label(text)

    def search(self):
        text = self.entry.get_text()
        query = text.strip()
        self._gen += 1
        self._stop_procs()
        if query.startswith(">"):
            self.search_commands(query[1:].strip())
        elif self.mode == "contents":
            self.search_contents(query)
        elif not query:
            self.show_recent()
        else:
            self.search_files(query, self._gen)

    def search_contents(self, query):
        n, busy = self.contents.count(), self.contents.busy
        status = f"{n:,} files indexed" + (f"  ·  indexing, {busy} to go" if busy else "")
        self.set_keys([("↵", "Open"), ("Ctrl ↵", "Show in Files"), ("Tab", "File names")])
        if not query:
            self.fill([], "")
            self.section.set_label(" ")
            self.show_empty("Search inside PDFs, Word, Excel, PowerPoint and LibreOffice files,\n"
                            "notes and code in Documents and Downloads", "edit-find-symbolic")
            self.say(status)
            return
        started = time.monotonic()
        hits = self.contents.search(query)
        items = [{"kind": "hit", "path": p, "snippet": s} for p, s in hits]
        self.fill(items, query, took=time.monotonic() - started, extra=status)

    def search_files(self, query, gen):
        if not GLib.find_program_in_path("plocate"):
            self.fill([], query)
            self.say("plocate is not installed: run  sudo bash system/install-system.sh $USER", warn=True)
            return
        started = time.monotonic()
        words = [w for w in query.lower().split() if w]
        self.live.prune(self.drives.index_time)
        apps = [{"kind": "app", "app": a} for a in self.apps.match(words)]
        sum_ = calc(query) if re.search(r"\d", query) and re.search(r"[-+*/^%()]", query) else None
        quick = ([{"kind": "cmd", "title": f"= {sum_}", "sub": f"{query}   ·   Enter copies the answer",
                   "icon": "accessories-calculator-symbolic", "copy": sum_.replace(" ", "")}] if sum_ else [])
        state = {"left": 1, "paths": list(self.live.match(words)), "root": []}

        def finish():
            state["left"] -= 1
            if state["left"] or gen != self._gen:
                return
            user = set(state["paths"])
            root_only = {p for p in state["root"] if p not in user}
            ranked = rank(state["paths"] + state["root"], query)
            shown = []
            for p in ranked:  # leave out files deleted since the last index refresh
                if p in root_only or os.path.lexists(p):
                    shown.append({"kind": "file", "path": p})
                    if len(shown) == SHOW:
                        break
            self._protected = root_only
            self.fill(quick + apps + shown, query, len(ranked), time.monotonic() - started)

        def done(proc, res, _data):
            try:
                _ok, out, _err = proc.communicate_utf8_finish(res)
                state["paths"].extend((out or "").splitlines())
            except GLib.Error:
                pass
            finish()

        def root_done(paths):
            state["root"].extend(paths)
            finish()

        for argv in plocate_cmds(query, self.drives.dbs()):
            try:
                p = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
            except GLib.Error:
                continue
            self._procs.append(p)
            state["left"] += 1
            p.communicate_utf8_async(None, None, done, None)
        if self.root.ready:
            for basename, limit in ((True, NAME_LIMIT), (False, PATH_LIMIT)):
                state["left"] += 1
                self.root.query(query.split(), limit, basename, root_done)
        finish()  # the initial count of 1

    def show_recent(self):
        items = []
        try:
            for it in Gtk.RecentManager.get_default().get_items():
                uri = it.get_uri()
                if uri.startswith("file://"):
                    path = Gio.File.new_for_uri(uri).get_path()
                    if path and os.path.exists(path):
                        items.append((it.get_modified().to_unix(), path))
        except GLib.Error:
            pass
        items.sort(reverse=True)
        self._protected = set()
        self.fill([{"kind": "file", "path": p} for _t, p in items[:12]], "")
        self.section.set_label("Recent" if items else " ")
        if not items:
            self.show_empty("Search every file, folder and app on this computer.\nType > for commands.")
        self.set_keys([("↵", "Open"), ("Ctrl ↵", "Show in Files"), (">", "Commands"), ("Tab", "Contents")])
        self.say(self._sources())

    def _sources(self):
        try:
            age = "index " + _ago(os.stat(DB).st_mtime)
        except OSError:
            age = "no index yet"
        parts = [age, "home live"]
        n = len(self.drives.mounted)
        if n:
            parts.append(f"{n} drive" + ("s" if n > 1 else ""))
        if self.root.ready:
            parts.append("protected on")
        return "  ·  ".join(parts)

    # ---------- commands ----------
    def search_commands(self, text):
        items = self.command_items(text)
        self.fill(items, "", cmd=True)
        self.section.set_label("Commands")
        if not items:
            self.show_empty("No command like that.\nType > on its own to see them all.", "system-run-symbolic")
        self.set_keys([("↵", "Run"), ("Esc", "Close")])
        self.say("Command bar")

    def command_items(self, text):
        def cmd(title, sub, icon, run=None, fill=None, copy=None):
            return {"kind": "cmd", "title": title, "sub": sub, "icon": icon, "run": run, "fill": fill, "copy": copy}

        if not text:
            return [cmd(d, u, i, fill=f"> {n} ") for n, u, d, i in COMMANDS]
        sum_ = calc(text[4:] if text.lower().startswith("calc") else text)
        if sum_ is not None and (text.lower().startswith("calc") or re.search(r"\d", text)):
            return [cmd(f"= {sum_}", f"{text}   ·   Enter copies the answer", "accessories-calculator-symbolic",
                        copy=sum_.replace(" ", ""))]
        head, _, arg = text.partition(" ")
        head, arg = head.lower(), arg.strip()
        exact = [c for c in COMMANDS if c[0] == head]
        if not exact:
            return [cmd(d, u, i, fill=f"> {n} ") for n, u, d, i in COMMANDS if n.startswith(head)
                    or (head in ("light",) and n == "dark") or (head in ("mute", "unmute") and n == "volume")] \
                if head not in ("light", "mute", "unmute") else self.command_items(
                    {"light": "dark light", "mute": "volume mute", "unmute": "volume unmute"}[head])
        name, _usage, _desc, icon = exact[0]
        bin_ = os.path.join(HOME, ".local", "bin")
        a = arg.lower()
        if name in ("wifi", "bluetooth"):
            label = "Wi-Fi" if name == "wifi" else "Bluetooth"
            on = ["nmcli", "radio", "wifi", "on"] if name == "wifi" else ["rfkill", "unblock", "bluetooth"]
            off = ["nmcli", "radio", "wifi", "off"] if name == "wifi" else ["rfkill", "block", "bluetooth"]
            rows = [cmd(f"Turn {label} on", " ".join(on), icon, run=lambda: _run(*on) and f"{label} on"),
                    cmd(f"Turn {label} off", " ".join(off), icon, run=lambda: _run(*off) and f"{label} off")]
            return [r for r in rows if not a or a in r["title"].lower().split()[-1:]] or rows
        if name == "vpn":
            opts = [("college", "Connect the college VPN"), ("proton", "Connect Proton VPN"),
                    ("off", "Turn VPN off"), ("next", "Next VPN (off, college, Proton)")]
            return [cmd(t, f"vpn {o}", icon, run=lambda o=o: _run(os.path.join(bin_, "vpn"), o) and f"VPN: {o}")
                    for o, t in opts if not a or o.startswith(a)]
        if name == "kill":
            if not a:
                return [cmd("Type the app's name", "for example  > kill chrome", icon)]
            groups = user_processes(a)
            return [cmd(f"Quit {k}", f"{len(p)} process{'es' if len(p) > 1 else ''}   ·   Enter ends them", icon,
                        run=lambda p=p, k=k: self._kill(p, k))
                    for k, p in sorted(groups.items(), key=lambda kv: -len(kv[1]))[:8]] or \
                [cmd(f"Nothing called “{arg}” is running", "", icon)]
        if name == "timer":
            if a in ("", "list", "cancel", "stop"):
                rows = [cmd(f"Cancel {t['label'] or 'timer'}  ({_fmt_secs(t['end'] - time.time())} left)",
                            f"ends at {time.strftime('%H:%M:%S', time.localtime(t['end']))}", icon,
                            run=lambda t=t: self._cancel_timer(t)) for t in self.timers]
                return rows or [cmd("No timers running", "> timer 25  starts a 25 minute timer", icon)]
            d = parse_duration(arg)
            if not d:
                return [cmd("Timer length?", "25 = 25 minutes   ·   90s   ·   1h30   ·   25 tea", icon)]
            secs, label = d
            return [cmd(f"Start a {_fmt_secs(secs)} timer" + (f" for {label}" if label else ""),
                        f"rings at {time.strftime('%H:%M', time.localtime(time.time() + secs))}", icon,
                        run=lambda: self._start_timer(secs, label))]
        if name == "calc":
            return [cmd("Type a sum", "18*42   ·   (3+4)^2   ·   sqrt(2)   ·   15% of 80 = 0.15*80", icon)]
        if name == "volume":
            if a in ("mute", "unmute"):
                v = "1" if a == "mute" else "0"
                return [cmd(a.capitalize(), "speaker", icon,
                            run=lambda: _run("pactl", "set-sink-mute", "@DEFAULT_SINK@", v) and a.capitalize())]
            m = re.match(r"^(\d{1,3})%?$", a)
            if m and int(m.group(1)) <= 150:
                n = int(m.group(1))
                return [cmd(f"Set volume to {n}%", "speaker", icon,
                            run=lambda: _run("pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{n}%") and f"Volume {n}%")]
            return [cmd("Volume level?", "volume 40   ·   mute   ·   unmute", icon)]
        if name == "dark":
            iface = "org.gnome.desktop.interface"
            rows = [cmd("Dark style", "", "weather-clear-night-symbolic",
                        run=lambda: _run("gsettings", "set", iface, "color-scheme", "prefer-dark") and "Dark style"),
                    cmd("Light style", "", "weather-clear-symbolic",
                        run=lambda: _run("gsettings", "set", iface, "color-scheme", "default") and "Light style")]
            return [r for r in rows if not a or a in r["title"].lower()] or rows
        if name == "lock":
            return [cmd("Lock the screen", "", icon, run=lambda: _run("loginctl", "lock-session") and "Locked")]
        if name == "suspend":
            return [cmd("Sleep now", "suspend", icon, run=lambda: _run("systemctl", "suspend") and "Sleeping")]
        return []

    def _kill(self, pids, name):
        n = 0
        for pid in pids:
            try:
                os.kill(pid, 15)
                n += 1
            except OSError:
                pass
        return f"Quit {name} ({n})"

    def _start_timer(self, secs, label):
        t = {"end": time.time() + secs, "label": label, "id": 0}

        def ring():
            if t in self.timers:
                self.timers.remove(t)
            _notify("Time's up" + (f": {label}" if label else ""), f"{_fmt_secs(secs)} timer finished")
            _run("canberra-gtk-play", "-i", "complete")
            return GLib.SOURCE_REMOVE

        t["id"] = GLib.timeout_add_seconds(secs, ring)
        self.timers.append(t)
        return f"Timer set: {_fmt_secs(secs)}" + (f" ({label})" if label else "")

    def _cancel_timer(self, t):
        if t in self.timers:
            GLib.source_remove(t["id"])
            self.timers.remove(t)
        return "Timer cancelled"

    # ---------- results ----------
    def fill(self, items, query, total=None, took=None, extra=None, cmd=False):
        self.list.remove_all()
        words = [w for w in query.lower().split() if w]
        for item in items:
            self.list.append(self._row(item, words))
        first = self.list.get_row_at_index(0)
        if first:
            self.list.select_row(first)
        self.scroll.get_vadjustment().set_value(0)
        self.stack.set_visible_child_name("list")
        if query and not cmd:
            self.section.set_label("Matches inside files" if self.mode == "contents" else "Results")
            if not items:
                self.show_empty(f"No results for “{query}”" + (
                    "\nOnly Documents and Downloads are searched inside" if self.mode == "contents" else ""))
            if self.mode == "files":
                self.set_keys([("↵", "Open"), ("Ctrl ↵", "Show in Files"), ("Tab", "Contents")])
            n = sum(1 for i in items if i["kind"] in ("file", "hit"))
            more = f"{total:,} results" if total is not None and total > n else f"{n} result" + ("" if n == 1 else "s")
            ms = f"  ·  {took * 1000:.0f} ms" if took is not None else ""
            self.say(f"{more}{ms}  ·  {extra or self._sources()}")

    def _icon(self, gicon, name="text-x-generic"):
        icon = Gtk.Image.new_from_gicon(gicon) if gicon else Gtk.Image.new_from_icon_name(name)
        icon.set_pixel_size(28)
        return icon

    def _row(self, item, words):
        kind = item["kind"]
        path = item.get("path")
        protected = path in self._protected if path else False
        mtime, tag = 0, None
        if kind in ("file", "hit"):
            try:
                info = Gio.File.new_for_path(path).query_info(
                    "standard::icon,standard::fast-content-type,time::modified", Gio.FileQueryInfoFlags.NONE, None)
                gicon = info.get_icon()
                mtime = info.get_attribute_uint64("time::modified")
            except GLib.Error:  # protected: guess the icon from the name
                ctype, _uncertain = Gio.content_type_guess(path, None)
                gicon = Gio.content_type_get_icon(ctype) if ctype else None
            icon = self._icon(gicon)
            name = os.path.basename(path.rstrip("/")) or path
            title_markup = _markup(name, words)
            if kind == "hit":
                sub_markup = snippet_markup(item["snippet"])
            else:
                sub_markup = GLib.markup_escape_text(_short(os.path.dirname(path)) or "/")
            tooltip = _short(path)
            tag = "PROTECTED" if protected else None
        elif kind == "app":
            a = item["app"]
            icon = self._icon(a.get_icon(), "application-x-executable")
            title_markup = _markup(a.get_display_name() or "", words)
            desc = a.get_description() or (a.get_generic_name() if hasattr(a, "get_generic_name") else "") or ""
            sub_markup = GLib.markup_escape_text(desc or "Application")
            tooltip, tag = desc or None, "APP"
        else:  # command
            icon = self._icon(None, item.get("icon") or "system-run-symbolic")
            icon.set_pixel_size(20)
            icon.set_size_request(28, 28)
            icon.add_css_class("cmdicon")
            title_markup = GLib.markup_escape_text(item["title"])
            sub_markup = GLib.markup_escape_text(item.get("sub") or "")
            tooltip = None

        title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
        title.set_markup(title_markup)
        title.add_css_class("name")
        sub = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END if kind == "hit" else Pango.EllipsizeMode.START)
        sub.set_markup(sub_markup)
        sub.add_css_class("snip" if kind == "hit" else "dir")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, hexpand=True, valign=Gtk.Align.CENTER)
        text.append(title)
        if sub_markup:
            text.append(sub)

        box = Gtk.Box(spacing=12)
        box.append(icon)
        box.append(text)
        if tag:
            t = Gtk.Label(label=tag)
            t.add_css_class("tag")
            box.append(t)
        verb = {"file": "Open", "hit": "Open", "app": "Launch"}.get(
            kind, "Copy" if item.get("copy") else "Use" if item.get("fill") else "Run" if item.get("run") else "")
        right = Gtk.Overlay(valign=Gtk.Align.CENTER)
        when = Gtk.Label(label=_when(mtime) if mtime else "", xalign=1)
        when.add_css_class("when")
        right.set_child(when)
        if verb:
            act = Gtk.Label(label=f"{verb}  ↵", halign=Gtk.Align.END, valign=Gtk.Align.CENTER)
            act.add_css_class("act")
            right.add_overlay(act)
            right.set_measure_overlay(act, True)
        box.append(right)
        row = Gtk.ListBoxRow()
        row.set_child(box)
        row.item = item
        if tooltip:
            row.set_tooltip_text(tooltip)

        if kind in ("file", "hit"):
            src = Gtk.DragSource(actions=Gdk.DragAction.COPY)
            src.connect("prepare", lambda *_: Gdk.ContentProvider.new_for_value(
                _value(Gdk.FileList, Gdk.FileList.new_from_list([_gfile(path, protected)]))))
            src.connect("drag-begin", self._on_drag_begin, icon)
            src.connect("drag-end", self._on_drag_end)
            row.add_controller(src)
        return row

    def _selected(self):
        row = self.list.get_selected_row() or self.list.get_row_at_index(0)
        return row.item if row else None

    # ---------- actions ----------
    def activate(self, item):
        if not item:
            return
        kind = item["kind"]
        if kind in ("file", "hit"):
            self.open(item["path"])
        elif kind == "app":
            try:
                item["app"].launch([], self.get_display().get_app_launch_context())
                self.set_visible(False)
            except GLib.Error as e:
                self.say(f"Can't start: {e.message}", warn=True)
        elif item.get("fill"):
            self.entry.set_text(item["fill"])
            self.entry.set_position(-1)
        elif item.get("copy"):
            self.get_display().get_clipboard().set(item["copy"])
            self.say(f"Copied  {item['copy']}")
            GLib.timeout_add(500, lambda: self.set_visible(False) or False)
        elif item.get("run"):
            msg = item["run"]()
            if msg:
                self.say(msg)
                GLib.timeout_add(450, lambda: self.set_visible(False) or False)
            else:
                self.say("That didn't work", warn=True)

    def open(self, path):
        try:
            ctx = self.get_display().get_app_launch_context()
            Gio.AppInfo.launch_default_for_uri(_gfile(path, path in self._protected).get_uri(), ctx)
            self.set_visible(False)
        except GLib.Error as e:
            self.say(f"Can't open: {e.message}", warn=True)

    def reveal(self, item):
        if not item or item["kind"] not in ("file", "hit"):
            return self.activate(item)
        path = item["path"]
        uri = _gfile(path, path in self._protected).get_uri()
        # through the launch context, so Files gets the activation token and comes to the front
        ctx = self.get_display().get_app_launch_context()
        try:
            files = Gio.AppInfo.create_from_commandline("nautilus --select", "Files",
                                                        Gio.AppInfoCreateFlags.SUPPORTS_URIS)
            files.launch_uris([uri], ctx)
        except GLib.Error:
            token = ctx.get_startup_notify_id(None, []) or ""
            Gio.DBus.session.call("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                                  "org.freedesktop.FileManager1", "ShowItems",
                                  GLib.Variant("(ass)", ([uri], token)),
                                  None, Gio.DBusCallFlags.NONE, 10000, None, None)
        self.set_visible(False)

    def copy_path(self, item):
        if item and item.get("path"):
            self.get_display().get_clipboard().set(item["path"])
            self.say(f"Copied  {_short(item['path'])}")

    def _move(self, step):
        row = self.list.get_selected_row()
        i = (row.get_index() + step) if row else 0
        nxt = self.list.get_row_at_index(max(0, i))
        if nxt:
            self.list.select_row(nxt)
            # keep the selected row in view without taking focus from the search box
            ok, rect = nxt.compute_bounds(self.list)
            if ok:
                adj = self.scroll.get_vadjustment()
                top, bottom = rect.get_y(), rect.get_y() + rect.get_height()
                if top < adj.get_value():
                    adj.set_value(top)
                elif bottom > adj.get_value() + adj.get_page_size():
                    adj.set_value(bottom - adj.get_page_size())

    def _on_key(self, _c, keyval, _code, state):
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        if keyval == Gdk.KEY_Escape:
            self.set_visible(False)
            return True
        if keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab, Gdk.KEY_KP_Tab):
            if not self.entry.get_text().lstrip().startswith(">"):
                self.set_mode("files" if self.mode == "contents" else "contents")
            return True
        if keyval in (Gdk.KEY_Down, Gdk.KEY_KP_Down):
            self._move(1)
            return True
        if keyval in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
            self._move(-1)
            return True
        if keyval in (Gdk.KEY_Page_Down, Gdk.KEY_Page_Up):
            self._move(8 if keyval == Gdk.KEY_Page_Down else -8)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter):
            (self.reveal if ctrl else self.activate)(self._selected())
            return True
        if ctrl and shift and keyval in (Gdk.KEY_a, Gdk.KEY_A):
            self.lock.set_active(not self.lock.get_active())
            return True
        if ctrl and keyval in (Gdk.KEY_c, Gdk.KEY_C) and not self.entry.get_selection_bounds():
            self.copy_path(self._selected())
            return True
        return False

    # ---------- drag out ----------
    def _on_drag_begin(self, source, _drag, icon):
        self._dragging = True
        paintable = icon.get_paintable()
        if paintable:
            source.set_icon(paintable, 16, 16)
        # step out of the way so the drop lands on the window underneath
        GLib.timeout_add(120, self._fade_out)

    def _fade_out(self):
        if self._dragging:
            self.set_opacity(0)
            self._passthrough(True)
        return GLib.SOURCE_REMOVE

    def _passthrough(self, on):
        surface = self.get_surface()
        if not surface:
            return
        try:
            gi.require_foreign("cairo")
            import cairo
            full = cairo.RectangleInt(0, 0, 10000, 10000)
            surface.set_input_region(cairo.Region() if on else cairo.Region(full))
        except Exception:  # pycairo missing: the window just stays see-through
            pass

    def _on_drag_end(self, *_):
        self._dragging = False
        self._passthrough(False)
        self.set_visible(False)
        self.set_opacity(1)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self._mood = watch_mood(Gdk.Display.get_default(), _mood_changed)
        self.win = Finder(self)
        self.hold()  # keep running while hidden

    def do_command_line(self, cmdline):
        if "--background" not in cmdline.get_arguments()[1:]:
            self.win.toggle()
        return 0


if __name__ == "__main__":
    raise SystemExit(App().run(sys.argv))
