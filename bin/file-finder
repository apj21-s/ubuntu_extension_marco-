MAX_WATCHES = 25000  # the per-user inotify limit (65536) is shared with editors etc.
NOISE = ("/.cache/", "/node_modules/", "/.git/", "/site-packages/", "/dist-packages/",
         "/__pycache__/", "/.venv/", "/venv/", "/.local/share/uv/", "/.cargo/registry/", "/.rustup/",
         "/.npm/", "/.local/share/Trash/", "/.vscode/extensions/", "/.antigravity", "/proc/", "/sys/",
         "/snap/", "/var/lib/", "/usr/share/doc/", "/usr/share/locale/", "/usr/src/", "/.mozilla/",
         "/.config/google-chrome/")
USER_DIRS = ("/Documents/", "/Downloads/", "/Desktop/", "/Pictures/", "/Music/", "/Videos/")
# folders not watched live (busy caches and tool data; the index still covers them)
NO_WATCH = {"node_modules", ".git", ".cache", "__pycache__", ".venv", "venv", "site-packages",
            ".cargo", ".rustup", ".npm", ".gradle", ".m2", ".local", "snap", ".vscode",
            ".antigravity", ".antigravity-ide", ".mozilla", ".config", "Trash", ".android",
            "Android", ".pub-cache", ".dartServer", ".nuget", ".conda", "miniconda3",
            "anaconda3", "go", ".java", ".Trash-1000", "$RECYCLE.BIN", "System Volume Information"}

