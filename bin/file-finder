#!/usr/bin/env python3
"""File Finder - one box for files, apps and commands (Super+F).

  * type                         -> files and folders from the whole disk, and matching apps
  * a sum (18*42)                -> the answer on top; Enter copies it
  * > command                    -> command bar: > wifi off, > vpn college, > kill chrome,
                                    > timer 25, > calc 18*42, > volume 40, > dark, > lock ...
                                    (type > on its own to see them all)
  * Tab                          -> search inside files (PDF, Word/Excel/PowerPoint/LibreOffice,
                                    notes, code) in Documents and Downloads; Tab again goes back
  * Up / Down                    -> move through the results
  * Enter / double-click         -> open / start / run
  * Ctrl+Enter                   -> show it in Files
  * Ctrl+C (nothing selected)    -> copy the path
  * Ctrl+Shift+A / lock button   -> also search protected files (asks for your password)
  * drag a result                -> drop it into any app (or onto the Drop Shelf)
  * Esc / click elsewhere        -> hide

Where results come from:
  * the system-wide plocate index (refreshed every 15 minutes on the charger, hourly on
    battery, and right after every apt install/remove)
  * a live watch on the home folder, so a file made a second ago is found at once
  * one index per USB drive, built as soon as the drive is plugged in, plus a live watch
  * protected mode: a root helper started with one password popup (pkexec) searches the
    files your user can't see (other users, /root, system data); it quits after 10 idle minutes
Files deleted since the last index refresh are left out.
The inside-files index (~/.cache/file-finder/content.db, SQLite full-text) is built in the
background at the lowest priority and kept up to date live by the same watch.

Stays running in the background (started hidden at login) so Super+F opens it instantly;
Super+F again hides it.
"""
import ast
import ctypes
import html
import json
import math
import os
import queue
import re
import sqlite3
import struct
import subprocess
import sys
import threading
import time
import urllib.parse
import zipfile

import gi
