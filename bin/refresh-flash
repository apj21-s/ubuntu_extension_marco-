#!/usr/bin/python3 -I
# Quick Windows-style "refresh" flash over the whole screen.
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib, Gdk

CSS = b"""
window.flash { background: rgba(255,255,255,0.28); }
"""

def on_activate(app):
    prov = Gtk.CssProvider(); prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                              Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = Gtk.ApplicationWindow(application=app, decorated=False)
    win.add_css_class("flash")
    win.set_can_target(False)
    win.fullscreen()
    win.present()
    state = {"op": 1.0}
    def fade():
        state["op"] -= 0.08
        if state["op"] <= 0:
            app.quit(); return False
        win.set_opacity(state["op"]); return True
    GLib.timeout_add(120, lambda: (GLib.timeout_add(16, fade), False)[1])

app = Gtk.Application(application_id="local.refresh.flash")
app.connect("activate", on_activate)
app.run(None)
