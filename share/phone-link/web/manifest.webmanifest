{
 "id": "/",
 "name": "Dropline",
 "short_name": "Dropline",
 "description": "Dropline: drop files between your phone and laptop",
 "start_url": "/app",
 "scope": "/",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#0c0b0a",
 "theme_color": "#34302b",
 "icons": [
  {
   "src": "/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "/icon-mono-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "monochrome"
  }
 ],
 "share_target": {
  "action": "/share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "*/*"
     ]
    }
   ]
  }
 }
}