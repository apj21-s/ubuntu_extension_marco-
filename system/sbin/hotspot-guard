#!/bin/bash
# Hotspot guard: alerts when a new device joins the "Hotspot" connection,
# with Allow / Kick / Block buttons. The "Hotspot" Quick Settings tile
# (hotspot-devices@arco) uses status / block / kick / unblock / untrust.
# Usage: hotspot-guard run | list | status | block|kick|unblock|untrust <MAC>
IFACE=@WIFI@
CONN=Hotspot
USER_NAME=@USER@
USER_ID=@UID@
DIR=/etc/hotspot-guard
RUN=/run/hotspot-guard
LEASES=/var/lib/NetworkManager/dnsmasq-$IFACE.leases
mkdir -p "$DIR" "$RUN/pending"; touch "$DIR/trusted" "$DIR/blocked" "$DIR/names" "$RUN/seen"

valid_mac() { [[ "$1" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]]; }
stations() { iw dev "$IFACE" station dump 2>/dev/null | awk '/^Station/{print tolower($2)}'; }
lease_info() {  # prints "name ip"
  awk -v m="$1" 'tolower($2)==m{print ($4=="*"?"Unknown-device":$4), $3}' "$LEASES" 2>/dev/null | tail -1
}
remember() {  # keep a device's name, so blocked devices still show it later
  [ -n "$2" ] && [ "$2" != Unknown-device ] || return 0
  { grep -v "^$1 " "$DIR/names"; echo "$1 $2"; } > "$DIR/names.tmp.$$" && mv "$DIR/names.tmp.$$" "$DIR/names"
}
name_of() {
  local n ip
  read -r n ip <<< "$(lease_info "$1")"
  [ -z "$n" ] || [ "$n" = Unknown-device ] && n=$(awk -v m="$1" '$1==m{print $2}' "$DIR/names" | tail -1)
  echo "${n:-Unknown-device}"
}
setup_nft() {
  nft -f - <<NFT
table inet hotspot_guard
delete table inet hotspot_guard
table inet hotspot_guard {
  set blocked { type ether_addr; }
  chain input   { type filter hook input   priority -10; iifname "$IFACE" ether saddr @blocked drop; }
  chain forward { type filter hook forward priority -10; iifname "$IFACE" ether saddr @blocked drop; }
}
NFT
  while read -r m; do valid_mac "$m" && nft add element inet hotspot_guard blocked "{ $m }"; done < "$DIR/blocked"
}
as_user() {
  [ -S /run/user/$USER_ID/bus ] || return 1
  runuser -u "$USER_NAME" -- env DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/$USER_ID \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$USER_ID/bus "$@"
}
notify_user() { as_user @HOME@/.local/bin/notify -a "Hotspot Guard" "$@"; }  # no buttons
kick() { iw dev "$IFACE" station del "$1" 2>/dev/null; }
block() {
  remember "$1" "$(name_of "$1")"
  sed -i "\|^$1\$|d" "$DIR/trusted"
  grep -qx "$1" "$DIR/blocked" || echo "$1" >> "$DIR/blocked"
  nft add element inet hotspot_guard blocked "{ $1 }" 2>/dev/null
  kick "$1"
}
unblock() {
  sed -i "\|^$1\$|d" "$DIR/blocked"
  nft delete element inet hotspot_guard blocked "{ $1 }" 2>/dev/null
  sed -i "\|^$1\$|d" "$RUN/seen"   # it gets asked about again when it rejoins
}
ask() {  # runs in background per new device
  mac=$1; read -r name ip <<< "$(lease_info "$mac")"
  sleep 4; [ -z "$name" ] && read -r name ip <<< "$(lease_info "$mac")"   # give DHCP a moment
  name=${name:-Unknown-device}
  remember "$mac" "$name"
  [ -S /run/user/$USER_ID/bus ] || { rm -f "$RUN/pending/$mac"; return; }
  choice=$(as_user /usr/local/sbin/hotspot-guard-notify "New device on your hotspot" \
    "$name  ${ip:+($ip)}"$'\n'"$mac" network-wireless-hotspot-symbolic \
    allow=Allow kick=Kick block=Block)
  case "$choice" in
    allow) echo "$mac" >> "$DIR/trusted"; notify_user -i emblem-ok-symbolic "Trusted: $name" "It won't be reported again." ;;
    kick)  kick "$mac";  notify_user -i network-wireless-hotspot-symbolic "Kicked: $name" "It was disconnected (it can rejoin)." ;;
    block)
      block "$mac"
      undo=$(as_user /usr/local/sbin/hotspot-guard-notify "Blocked: $name" \
        "No internet for it on your hotspot. Unblock it any time from Quick Settings → Hotspot." \
        action-unavailable-symbolic unblock=Unblock)
      if [ "$undo" = unblock ]; then
        unblock "$mac"; notify_user -i emblem-ok-symbolic "Unblocked: $name" "It can use your hotspot again."
      fi ;;
  esac
  rm -f "$RUN/pending/$mac"
}
hotspot_on() { nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx "$CONN"; }
mac_arg() {
  m=$(echo "$1" | tr A-Z a-z); valid_mac "$m" || { echo "Not a MAC address: $1"; exit 2; }
}

case "${1:-run}" in
  run)
    setup_nft
    while true; do
      if hotspot_on; then
        for mac in $(stations); do
          if grep -qx "$mac" "$DIR/blocked"; then kick "$mac"; continue; fi
          grep -qx "$mac" "$DIR/trusted" && continue
          grep -qx "$mac" "$RUN/seen" && continue
          echo "$mac" >> "$RUN/seen"; touch "$RUN/pending/$mac"
          ask "$mac" &
        done
      else
        : > "$RUN/seen"   # hotspot off: ask again next time unknown devices join
      fi
      sleep 3
    done ;;
  list)
    echo "Connected now:"
    for mac in $(stations); do
      read -r name ip <<< "$(lease_info "$mac")"
      tag=""; grep -qx "$mac" "$DIR/trusted" && tag="(trusted)"
      printf '  %-20s %-16s %s %s\n' "${name:-Unknown-device}" "${ip:--}" "$mac" "$tag"
    done
    echo "Trusted:"; sed 's/^/  /' "$DIR/trusted"
    echo "Blocked:"; sed 's/^/  /' "$DIR/blocked" ;;
  status)  # tab-separated, for the Quick Settings tile
    if hotspot_on; then
      printf 'active\t1\n'
      for mac in $(stations); do
        grep -qx "$mac" "$DIR/blocked" && continue
        read -r name ip <<< "$(lease_info "$mac")"
        [ -z "$name" ] || [ "$name" = Unknown-device ] && name=$(name_of "$mac")
        t=0; grep -qx "$mac" "$DIR/trusted" && t=1
        printf 'C\t%s\t%s\t%s\t%s\n' "$mac" "$name" "${ip:--}" "$t"
      done
    else
      printf 'active\t0\n'
    fi
    while read -r m; do valid_mac "$m" && printf 'B\t%s\t%s\n' "$m" "$(name_of "$m")"; done < "$DIR/blocked"
    while read -r m; do valid_mac "$m" && printf 'T\t%s\t%s\n' "$m" "$(name_of "$m")"; done < "$DIR/trusted"
    ;;
  block)   mac_arg "$2"; block "$m"; echo "Blocked $m" ;;
  kick)    mac_arg "$2"; kick "$m"; echo "Kicked $m" ;;
  unblock) mac_arg "$2"; unblock "$m"; echo "Unblocked $m" ;;
  untrust)
    mac_arg "$2"
    sed -i "\|^$m\$|d" "$DIR/trusted"; sed -i "\|^$m\$|d" "$RUN/seen"; echo "Removed $m from trusted" ;;
  *) echo "Usage: hotspot-guard run|list|status|block|kick|unblock|untrust MAC"; exit 2 ;;
esac
